# Compose controls
DIVO_ENV_FILE=.env.production.local
DIVO_BACKEND_IMAGE=divo-backend:local
DIVO_ADMIN_IMAGE=divo-admin:local
DIVO_BACKEND_PORT=3001
DIVO_ADMIN_PORT=8081
VITE_API_BASE_URL=

# Runtime
NODE_ENV=production
PORT=3001
APP_BASE_URL=https://divo.outreachdeal.com
BACKEND_PUBLIC_URL=https://divo.outreachdeal.com

# Database
DIVO_POSTGRES_DB=divo
DIVO_POSTGRES_USER=divo_app
DIVO_POSTGRES_PASSWORD=CHANGE_ME
DIVO_POSTGRES_BIND=127.0.0.1
DIVO_POSTGRES_PORT=5432
DATABASE_URL=postgresql://divo_app:CHANGE_ME@divo-postgres:5432/divo?schema=public

# Redis is normally supplied by docker-compose.yml for the three Redis containers.
# Keep these values aligned with docker-compose.yml unless intentionally overriding.
REDIS_URL=redis://divo-redis-cache:6379/0
REDIS_QUEUE_URL=redis://divo-redis-queue:6379/0
REDIS_CACHE_URL=redis://divo-redis-cache:6379/0
REDIS_MEMORY_URL=redis://divo-redis-memory:6379/0

# AI
MODEL_PROVIDER=google
MODEL_ID=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=divo_vectors
QDRANT_RETRIEVAL_COLLECTION=retrieval_v3

# Lark
LARK_API_BASE_URL=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=
LARK_WEBHOOK_SIGNING_SECRET=
LARK_OAUTH_REDIRECT_URI=https://divo.outreachdeal.com/api/lark/auth/callback

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://divo.outreachdeal.com/api/google/auth/callback

# Zoho OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://divo.outreachdeal.com/api/zoho/auth/callback
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_PROVIDER_DEFAULT=rest
ZOHO_MCP_ENABLED=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin/member auth
ADMIN_JWT_SECRET=
MEMBER_JWT_SECRET=
INTERNAL_API_KEY=

# Optional integrations/tuning
SERPER_API_KEY=
GATEWAY_BASE_URL=
GATEWAY_ADMIN_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
DYNAMIC_GRAPH_ENABLED=false
DYNAMIC_GRAPH_SHADOW=false
SUPERVISOR_TIMEOUT_MS=300000
MEM0_ENABLED=false
MEM0_EXTRACTION_MODEL=gpt-4o-mini
MEM0_QDRANT_COLLECTION=divo_memories
MEM0_MAX_RESULTS=10
