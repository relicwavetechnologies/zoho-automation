# Copy this to the GitHub Environment secret DIVO_DEV_ENV_FILE. Do not commit the real file.
DIVO_DEV_PUBLIC_URL=https://app-dev.103.172.92.187.sslip.io
DIVO_DEV_POSTGRES_DB=divo_dev
DIVO_DEV_POSTGRES_USER=divo_dev_app
DIVO_DEV_POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://divo_dev_app:replace-with-the-same-random-hex-password@divo-dev-postgres:5432/divo_dev

# Required by the backend schema even when the integrations are intentionally disabled in dev.
OPENAI_API_KEY=dev-not-configured
LARK_APP_ID=dev-not-configured
LARK_APP_SECRET=dev-not-configured

# Unique secrets for the development database and sessions.
ADMIN_JWT_SECRET=replace-with-a-random-hex-secret
MEMBER_JWT_SECRET=replace-with-a-random-hex-secret
ZOHO_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-random-hex-secret
PROXY_KEY_ENCRYPTION_KEY=replace-with-a-32-byte-random-hex-secret

# Keep external integrations inert until dedicated development credentials are supplied.
LLM_PROXY_ENABLED=false
EMBEDDING_PROVIDER=fallback
LOG_LEVEL=info
LOG_SUCCESS_SAMPLE_RATE=0.05
LOG_INCLUDE_STACK=false
