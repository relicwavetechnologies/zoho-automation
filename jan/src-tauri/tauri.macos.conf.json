{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Divo Dex",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["fullScreenUI", "mica", "tabbed", "blur", "acrylic"],
          "state": "active"
        },
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": [
      "resources/pre-install/**/*",
      "resources/LICENSE",
      "resources/bin/jan-cli",
      "resources/bin/sqlite-vec.dylib",
      "resources/pi/package.json",
      "resources/pi/pi-chrome-devtools-bridge.mjs",
      "resources/pi/agent-template/**/*",
      "resources/pi/agent-npm/**/*",
      "resources/pi-extensions/**/*",
      "resources/pi-skills/**/*",
      "resources/pi/node_modules/**/*",
      "resources/lark-cli/**/*"
    ],
    "externalBin": ["resources/bin/bun", "resources/bin/uv"],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
