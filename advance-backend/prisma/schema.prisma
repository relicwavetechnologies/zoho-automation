generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VectorVisibility {
  personal
  shared
  public
}

enum IngestionStatus {
  pending
  processing
  done
  failed
}

enum ScheduledWorkflowStatus {
  draft
  published
  active
  scheduled_active
  paused
  archived
}

enum ScheduledWorkflowScheduleType {
  one_time
  hourly
  daily
  weekly
  monthly
}

enum ScheduledWorkflowRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
  skipped
  blocked
}

enum TaskStatus {
  pending
  running
  hitl
  done
  failed
  cancelled
}

enum UserMemoryKind {
  identity
  response_style
  preference
  constraint
  ongoing_task
  project
  decision
  tool_routing
}

enum UserMemoryScope {
  user_global
  thread_pinned
}

enum UserMemoryStatus {
  active
  archived
  forgotten
  superseded
}

enum UserMemorySource {
  user_explicit
  assistant_compacted
  tool_result
}

enum UserMemoryChannelOrigin {
  desktop
  lark
}

enum UserMemoryReplyLength {
  short
  balanced
  detailed
}

enum UserMemoryTone {
  neutral
  warm
  direct
}

enum UserMemoryFormatting {
  paragraphs
  bullets
}

// Manager-persona learning is deliberately isolated from personal memory.
// These rows are evidence/candidates only in P1–P3; no active department
// persona is written by this pipeline until the promotion phase exists.
enum PersonaLearningEvidenceStatus {
  eligible
  skipped
}

enum PersonaLearningJobStatus {
  queued
  processing
  shadow_complete
  no_learning
  failed
}

enum PersonaLearningCandidateKind {
  preference
  correction
  workflow
  skill
  contradiction
}

enum PersonaLearningEvidenceStrength {
  explicit
  confirmed
  inferred
}

enum PersonaLearningCandidateStatus {
  shadow
  active
}

// Active manager persona is its own bounded, department-scoped tree. It is
// deliberately neither user memory nor a Skill/SkillVersion substitute.
enum ManagerPersonaNodeStatus {
  active
  superseded
  quarantined
}

// Explicit manager teaching is a separate ingestion path from passive
// after-run learning. It produces persona-only evidence in later phases.
enum ManagerTeachSource {
  recording
  upload
}

enum ManagerTeachSessionStatus {
  awaiting_upload
  queued
  ingesting
  ready_for_processing
  failed
  cancelled
}

enum ManagerTeachArtifactKind {
  raw_video
  evidence_manifest
}

enum ManagerTeachArtifactStatus {
  available
  deleted
}

model User {
  id                                 String                       @id @default(uuid())
  email                              String                       @unique
  password                           String
  name                               String?
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt
  adminMemberships                   AdminMembership[]
  adminSessions                      AdminSession[]
  departmentMemberships              DepartmentMembership[]
  departmentUserToolOverrides        DepartmentUserToolOverride[]
  createdDepartmentAgentConfigs      DepartmentAgentConfig[]      @relation("DepartmentAgentConfigCreatedBy")
  updatedDepartmentAgentConfigs      DepartmentAgentConfig[]      @relation("DepartmentAgentConfigUpdatedBy")
  createdCompanyPromptProfiles       CompanyPromptProfile[]       @relation("CompanyPromptProfileCreatedBy")
  updatedCompanyPromptProfiles       CompanyPromptProfile[]       @relation("CompanyPromptProfileUpdatedBy")
  createdZohoConnectionProfiles      ZohoConnectionProfile[]      @relation("ZohoConnectionProfileCreatedBy")
  updatedZohoConnectionProfiles      ZohoConnectionProfile[]      @relation("ZohoConnectionProfileUpdatedBy")
  departmentToolPermissionsUpdated   DepartmentToolPermission[]   @relation("DepartmentToolPermissionUpdatedBy")
  departmentUserToolOverridesUpdated DepartmentUserToolOverride[] @relation("DepartmentUserToolOverrideUpdatedBy")
  memberSessions                     MemberSession[]
  desktopHandoffs                    DesktopAuthHandoff[]
  desktopWorkspaces                  DesktopWorkspace[]
  desktopThreads                     DesktopThread[]
  scheduledWorkflowsCreated          ScheduledWorkflow[]          @relation("ScheduledWorkflowCreatedBy")
  executionRuns                      ExecutionRun[]
  larkAuthLinks                      LarkUserAuthLink[]
  ownedIntegrationConnections        IntegrationConnection[]      @relation("IntegrationConnectionOwner")
  createdIntegrationConnections      IntegrationConnection[]      @relation("IntegrationConnectionCreatedBy")
  createdSerperConnections           CompanySerperConnection[]    @relation("CompanySerperConnectionCreatedBy")
  grantedIntegrationConnectionGrants IntegrationConnectionGrant[] @relation("IntegrationConnectionGrantGrantedBy")
  memoryItems                        UserMemoryItem[]
  memoryProfiles                     UserMemoryProfile[]
  departmentPreference               UserDepartmentPreference?
  personaLearningEvidenceAsManager   PersonaLearningEvidence[]    @relation("PersonaLearningEvidenceManager")
  personaLearningCandidatesAsManager PersonaLearningCandidate[]   @relation("PersonaLearningCandidateManager")
  managerPersonaTrees                ManagerPersonaTree[]         @relation("ManagerPersonaTreeManager")
  managerPersonaNodes                ManagerPersonaNode[]         @relation("ManagerPersonaNodeManager")
  managerTeachSessions               ManagerTeachSession[]        @relation("ManagerTeachSessionManager")
}

model Company {
  id                          String                       @id @default(uuid())
  name                        String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  gatewayApiKey               String?                      @map("gateway_api_key")
  gatewayUrl                  String?                      @map("gateway_url")
  gatewayDedicatedAccountId   String?                      @map("gateway_dedicated_account_id")
  defaultAiProvider           String                       @default("google") @map("default_ai_provider")
  defaultAiModel              String                       @default("gemini-3.1-flash-lite") @map("default_ai_model")
  promptProfile               CompanyPromptProfile?
  departments                 Department[]
  skills                      Skill[]
  skillFolders                SkillFolder[]
  skillAccessGrants           SkillAccessGrant[]
  skillRegistryRevision       SkillRegistryRevision?
  zohoConnections             ZohoConnection[]
  zohoConnectionProfiles      ZohoConnectionProfile[]
  zohoSyncJobs                ZohoSyncJob[]
  zohoOAuthConfig             ZohoOAuthConfig?
  larkTenantBindings          LarkTenantBinding[]
  larkWorkspaceConfig         LarkWorkspaceConfig?
  larkOperationalConfig       LarkOperationalConfig?
  larkDirectorySyncRuns       LarkDirectorySyncRun[]
  adminMemberships            AdminMembership[]
  adminSessions               AdminSession[]
  invites                     CompanyInvite[]
  mcpActionLogs               McpActionLog[]
  channelIdentities           ChannelIdentity[]
  toolPermissions             ToolPermission[]
  toolActionPermissions       ToolActionPermission[]
  booksModulePermissions      BooksModulePermission[]
  zohoRoleAccessPolicies      ZohoRoleAccessPolicy[]
  aiRoleDefinitions           AiRoleDefinition[]
  vectorDocuments             VectorDocument[]
  vectorShareRequests         VectorShareRequest[]
  memberSessions              MemberSession[]
  desktopHandoffs             DesktopAuthHandoff[]
  desktopWorkspaces           DesktopWorkspace[]
  desktopThreads              DesktopThread[]
  larkChatContexts            LarkChatContext[]
  scheduledWorkflows          ScheduledWorkflow[]
  executionRuns               ExecutionRun[]
  larkAuthLinks               LarkUserAuthLink[]
  integrationConnections      IntegrationConnection[]
  integrationConnectionGrants IntegrationConnectionGrant[]
  serperConnections           CompanySerperConnection[]
  fileAssets                  FileAsset[]
  outboundArtifacts           OutboundArtifact[]
  userMemoryItems             UserMemoryItem[]
  userMemoryProfiles          UserMemoryProfile[]
  taskRuns                    TaskRun[]
  userDepartmentPreferences   UserDepartmentPreference[]
  agentDefinitions            AgentDefinition[]
  channelAgentMappings        ChannelAgentMapping[]
  personaLearningEvidences    PersonaLearningEvidence[]
  personaLearningCandidates   PersonaLearningCandidate[]
  managerPersonaTrees         ManagerPersonaTree[]
  managerPersonaNodes         ManagerPersonaNode[]
  managerTeachSessions        ManagerTeachSession[]
}

model RegisteredTool {
  id            String   @id @default(cuid())
  toolId        String   @unique
  name          String
  description   String
  category      String
  domain        String
  promptSnippet String?
  recoveryHint  String?
  hitlRequired  Boolean  @default(false)
  guardrails    String[]
  deprecated    Boolean  @default(false)
  engines       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgentDefinition {
  id                    String                @id @default(cuid())
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  name                  String
  slug                  String
  description           String?
  capabilityDescription String?
  systemPrompt          String
  hookId                String?
  maxSteps              Int                   @default(8)
  temperature           Float                 @default(0)
  isRootAgent           Boolean               @default(false)
  isActive              Boolean               @default(true)
  toolIds               String[]
  modelId               String?
  provider              String?
  parentId              String?
  parent                AgentDefinition?      @relation("AgentChildren", fields: [parentId], references: [id])
  children              AgentDefinition[]     @relation("AgentChildren")
  channelMappings       ChannelAgentMapping[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model ChannelAgentMapping {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  channelType       String
  channelIdentifier String
  agentDefinitionId String
  agentDefinition   AgentDefinition @relation(fields: [agentDefinitionId], references: [id])
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, channelType, channelIdentifier])
}

model CompanyPromptProfile {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyContext     String
  systemsOfRecord    String
  businessRules      String
  communicationStyle String
  formattingDefaults String
  restrictedClaims   String
  isActive           Boolean  @default(true)
  createdBy          String
  createdByUser      User     @relation("CompanyPromptProfileCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy          String
  updatedByUser      User     @relation("CompanyPromptProfileUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, isActive])
}

model UserDepartmentPreference {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeDepartmentId String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId, companyId])
}

model TaskRun {
  id              String     @id @default(cuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationKey String
  channel         String
  status          TaskStatus @default(pending)
  inputMessage    Json
  currentStep     String?
  failureReason   String?
  requeueCount    Int        @default(0)
  lastHeartbeatAt DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, conversationKey, status])
  @@index([status, createdAt])
}

model UserMemoryItem {
  id              String                  @id @default(uuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            UserMemoryKind
  scope           UserMemoryScope
  channelOrigin   UserMemoryChannelOrigin
  threadId        String?
  conversationKey String?
  subjectKey      String
  summary         String
  valueJson       Json
  confidence      Float
  status          UserMemoryStatus        @default(active)
  source          UserMemorySource
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  lastConfirmedAt DateTime?
  staleAfterAt    DateTime?
  supersededById  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([companyId, userId, status, kind, updatedAt])
  @@index([companyId, userId, subjectKey, status])
  @@index([companyId, userId, status, scope, threadId, conversationKey])
}

model UserMemoryProfile {
  id                      String                 @id @default(uuid())
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredReplyLength    UserMemoryReplyLength?
  preferredTone           UserMemoryTone?
  preferredFormatting     UserMemoryFormatting?
  updatedFromMemoryItemId String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([companyId, userId])
}

model AdminMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, role, isActive])
  @@index([companyId, role, isActive])
}

model AdminSession {
  id        String    @id @default(uuid())
  sessionId String    @unique @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, role, expiresAt])
  @@index([companyId, role, expiresAt])
}

model ZohoConnection {
  id                    String           @id @default(uuid())
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  environment           String           @default("prod")
  providerMode          String           @default("rest")
  status                String
  connectedAt           DateTime
  scopes                String[]
  lastSyncAt            DateTime?
  mcpBaseUrl            String?
  mcpApiKeyEncrypted    String?
  mcpWorkspaceKey       String?
  mcpAllowedTools       String[]
  mcpCapabilities       Json?
  mcpLastHealthAt       DateTime?
  mcpLastHealthStatus   String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenCipherVersion    Int              @default(1)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenFailureCode      String?
  lastTokenRefreshAt    DateTime?
  tokenMetadata         Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  syncJobs              ZohoSyncJob[]
  vectorDocs            VectorDocument[]

  @@unique([companyId, environment])
}

model ZohoConnectionProfile {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profileName           String
  environment           String    @default("prod")
  connectionSource      String    @default("manual_token_set")
  status                String    @default("CONNECTED")
  isActive              Boolean   @default(false)
  connectedAt           DateTime?
  scopes                String[]
  clientId              String
  clientSecretEncrypted String
  redirectUri           String
  accountsBaseUrl       String    @default("https://accounts.zoho.com")
  apiBaseUrl            String    @default("https://www.zohoapis.com")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenCipherVersion    Int       @default(1)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenMetadata         Json?
  disabledAt            DateTime?
  createdBy             String
  createdByUser         User      @relation("ZohoConnectionProfileCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy             String
  updatedByUser         User      @relation("ZohoConnectionProfileUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([companyId, profileName])
  @@index([companyId, isActive, status])
}

model ZohoOAuthConfig {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId              String
  clientSecretEncrypted String
  redirectUri           String
  accountsBaseUrl       String   @default("https://accounts.zoho.com")
  apiBaseUrl            String   @default("https://www.zohoapis.com")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ChannelIdentity {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel            String
  externalUserId     String
  externalTenantId   String
  displayName        String?
  email              String?
  larkOpenId         String?
  larkUserId         String?
  sourceRoles        String[] @default([])
  aiRole             String   @default("MEMBER")
  aiRoleSource       String   @default("sync")
  syncedAiRole       String?
  syncedFromLarkRole String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([channel, externalUserId, companyId])
  @@index([companyId, larkOpenId])
  @@index([companyId, larkUserId])
  @@index([companyId, channel])
}

model LarkWorkspaceConfig {
  id                               String   @id @default(uuid())
  companyId                        String   @unique
  company                          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appId                            String
  appSecretEncrypted               String
  verificationTokenEncrypted       String?
  signingSecretEncrypted           String?
  staticTenantAccessTokenEncrypted String?
  apiBaseUrl                       String   @default("https://open.larksuite.com")
  createdBy                        String
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

model LarkOperationalConfig {
  id                  String   @id @default(uuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultBaseAppToken String?
  defaultBaseTableId  String?
  defaultBaseViewId   String?
  defaultTasklistId   String?
  defaultCalendarId   String?
  defaultApprovalCode String?
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model LarkDirectorySyncRun {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trigger      String
  status       String
  syncedCount  Int       @default(0)
  adminCount   Int       @default(0)
  memberCount  Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  diagnostics  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model LarkTenantBinding {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  larkTenantKey String
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([larkTenantKey])
  @@index([companyId, isActive])
}

model McpActionLog {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId      String
  actionName  String
  payloadHash String
  status      String
  receipt     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([taskId, createdAt])
}

model ZohoSyncJob {
  id               String             @id @default(uuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectionId     String
  connection       ZohoConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  jobType          String
  status           String
  progressPercent  Int                @default(0)
  checkpoint       String?
  totalBatches     Int?
  processedBatches Int                @default(0)
  retryCount       Int                @default(0)
  maxAttempts      Int                @default(3)
  queuedAt         DateTime           @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  correlationId    String?
  payload          Json?
  errorMessage     String?
  events           ZohoSyncJobEvent[]

  @@index([companyId, status])
  @@index([connectionId, jobType, status])
}

model ZohoDeltaEvent {
  id         String   @id @default(uuid())
  companyId  String
  eventKey   String   @unique
  sourceType String
  sourceId   String
  operation  String
  changedAt  DateTime
  payload    Json?
  status     String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, status])
}

model ZohoSyncJobEvent {
  id         String      @id @default(uuid())
  jobId      String
  job        ZohoSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  message    String?
  payload    Json?
  createdAt  DateTime    @default(now())

  @@index([jobId, createdAt])
}

model VectorDocument {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectionId           String?
  connection             ZohoConnection?  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  fileAssetId            String?
  fileAsset              FileAsset?       @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  sourceType             String
  sourceId               String
  chunkIndex             Int
  documentKey            String?
  contentHash            String
  visibility             VectorVisibility @default(shared)
  ownerUserId            String?
  conversationKey        String?
  chunkText              String?
  payload                Json
  embedding              Float[]          @default([])
  embeddingSchemaVersion String?
  retrievalProfile       String?
  sourceUpdatedAt        DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([companyId, sourceType, sourceId, chunkIndex])
  @@index([companyId, sourceType])
  @@index([companyId, visibility, ownerUserId])
  @@index([companyId, conversationKey])
  @@index([fileAssetId])
  @@index([documentKey])
}

model FileAsset {
  id                     String             @id @default(uuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploaderUserId         String
  uploaderChannel        String // "lark" | "desktop"
  fileName               String
  mimeType               String
  sizeBytes              Int
  cloudinaryPublicId     String
  cloudinaryUrl          String
  cloudinaryResourceType String             @default("raw")
  ingestionStatus        IngestionStatus    @default(pending)
  ingestionError         String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  accessPolicies         FileAccessPolicy[]
  vectorDocs             VectorDocument[]
  outboundArtifacts      OutboundArtifact[]

  @@index([companyId, uploaderUserId])
  @@index([companyId, ingestionStatus])
}

model OutboundArtifact {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId  String?
  sourceSystem     String
  sourceKind       String
  sourceRecordType String?
  sourceRecordId   String?
  sourceMetadata   Json?
  fileAssetId      String?
  fileAsset        FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKind      String     @default("inline_base64")
  contentBase64    String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, sourceSystem, sourceKind])
  @@index([companyId, sourceRecordType, sourceRecordId])
  @@index([fileAssetId])
}

model FileAccessPolicy {
  id          String    @id @default(uuid())
  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  companyId   String
  aiRole      String
  canRead     Boolean   @default(true)
  grantedBy   String
  createdAt   DateTime  @default(now())

  @@unique([fileAssetId, aiRole])
  @@index([companyId, aiRole])
}

model VectorShareRequest {
  id                         String    @id @default(uuid())
  companyId                  String
  company                    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterUserId            String
  requesterChannelIdentityId String?
  conversationKey            String
  status                     String
  reason                     String?
  decisionNote               String?
  reviewedBy                 String?
  reviewedAt                 DateTime?
  expiresAt                  DateTime?
  promotedVectorCount        Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, requesterUserId, conversationKey])
}

model IngressIdempotencyKey {
  id        String   @id @default(uuid())
  channel   String
  messageId String   @unique
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

model RbacPermission {
  id        String   @id @default(uuid())
  role      String
  action    String
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String

  @@unique([role, action])
  @@index([role, allowed])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  companyId String?
  action    String
  outcome   String
  metadata  Json?
