generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduledWorkflowStatus {
  draft
  published
  active
  scheduled_active
  paused
  archived
}

enum ScheduledWorkflowScheduleType {
  one_time
  hourly
  daily
  weekly
  monthly
}

enum ScheduledWorkflowRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
  skipped
  blocked
}

enum KnowledgeResourceKind {
  memory
  skill
  file
}

enum KnowledgeResourceScope {
  personal
  department
  company
}

enum KnowledgeResourceStatus {
  draft
  active
  archived
  deleted
}

enum KnowledgeMutationAction {
  create
  update
  publish
  delete
}

enum KnowledgeMutationStatus {
  awaiting_requester_review
  awaiting_approval
  approved
  applying
  applied
  rejected
  cancelled
  failed
  superseded
}

enum KnowledgeApprovalAuthority {
  none
  department_manager
  company_admin
}

enum KnowledgeOutboxStatus {
  pending
  processing
  completed
  failed
}

enum KnowledgeFileAssetStatus {
  staged
  deleting
  attached
  deleted
}

enum KnowledgeFileDocumentStatus {
  processing
  ready
  failed
  superseded
  deleted
}

enum KnowledgeLearningJobStatus {
  queued
  processing
  completed
  no_learning
  failed
}

enum ShopifyPrivacyRequestState {
  received
  ready
  delivered
  expired
  redacted
  failed
}

// Manager-persona learning is deliberately isolated from personal memory.
// These rows are evidence/candidates only in P1–P3; no active department
// persona is written by this pipeline until the promotion phase exists.
enum PersonaLearningEvidenceStatus {
  eligible
  skipped
}

enum PersonaLearningJobStatus {
  queued
  processing
  shadow_complete
  no_learning
  failed
}

enum PersonaLearningCandidateKind {
  preference
  correction
  workflow
  skill
  contradiction
}

enum PersonaLearningEvidenceStrength {
  explicit
  confirmed
  inferred
}

enum PersonaLearningCandidateStatus {
  shadow
  active
  reverted
}

// Active manager persona is its own bounded, department-scoped tree. It is
// deliberately neither user memory nor a Skill/SkillVersion substitute.
enum ManagerPersonaNodeStatus {
  active
  superseded
  quarantined
}

// Canonical learning decision recorded for every Teach-sourced persona or
// skill transition. Clarification happens before a mutation and is retained in
// the mutation readiness receipt, so it is intentionally not an applied edge.
enum ManagerLearningDecision {
  create
  merge
  replace
  retire
}

// Explicit manager teaching is separate from passive after-run learning.
// Media compilation is durable on the backend; an interactive desktop Pi
// session interprets that evidence and submits governed persona/skill writes.
enum ManagerTeachSource {
  recording
  upload
}

enum ManagerTeachSessionStatus {
  awaiting_upload
  queued
  ingesting
  evidence_ready
  agent_processing
  completed
  // Legacy server-synthesis states are retained for historical rows only.
  ready_for_processing
  persona_processing
  persona_updated
  no_learning
  failed
  cancelled
}

enum ManagerTeachPersonaMutationStatus {
  applied
  no_learning
}

enum ManagerTeachArtifactKind {
  raw_video
  evidence_manifest
}

enum ManagerTeachArtifactStatus {
  available
  deleted
}

model User {
  id                                 String                          @id @default(uuid())
  email                              String                          @unique
  password                           String
  name                               String?
  /// The person's picture, as Lark hands it over at sign-in.
  ///
  /// On `User` rather than on a session or a link: it is a fact about the
  /// person, and kept per session it would vanish the moment they signed in
  /// somewhere Lark was not involved. Nullable forever — password sign-in never
  /// produces one, and every surface falls back to initials.
  ///
  /// A URL rather than the image itself. Lark serves it and Lark expires it;
  /// copying the bytes would leave Divo holding a photograph of an employee
  /// that no longer changes when they change theirs.
  avatarUrl                          String?
  createdAt                          DateTime                        @default(now())
  updatedAt                          DateTime                        @updatedAt
  adminMemberships                   AdminMembership[]
  adminSessions                      AdminSession[]
  departmentMemberships              DepartmentMembership[]
  departmentUserToolOverrides        DepartmentUserToolOverride[]
  createdDepartmentAgentConfigs      DepartmentAgentConfig[]         @relation("DepartmentAgentConfigCreatedBy")
  updatedDepartmentAgentConfigs      DepartmentAgentConfig[]         @relation("DepartmentAgentConfigUpdatedBy")
  createdZohoConnectionProfiles      ZohoConnectionProfile[]         @relation("ZohoConnectionProfileCreatedBy")
  updatedZohoConnectionProfiles      ZohoConnectionProfile[]         @relation("ZohoConnectionProfileUpdatedBy")
  departmentToolPermissionsUpdated   DepartmentToolPermission[]      @relation("DepartmentToolPermissionUpdatedBy")
  departmentUserToolOverridesUpdated DepartmentUserToolOverride[]    @relation("DepartmentUserToolOverrideUpdatedBy")
  memberSessions                     MemberSession[]
  desktopHandoffs                    DesktopAuthHandoff[]
  desktopWorkspaces                  DesktopWorkspace[]
  desktopThreads                     DesktopThread[]
  scheduledWorkflowsCreated          ScheduledWorkflow[]             @relation("ScheduledWorkflowCreatedBy")
  executionRuns                      ExecutionRun[]
  larkAuthLinks                      LarkUserAuthLink[]
  ownedIntegrationConnections        IntegrationConnection[]         @relation("IntegrationConnectionOwner")
  createdIntegrationConnections      IntegrationConnection[]         @relation("IntegrationConnectionCreatedBy")
  createdSerperConnections           CompanySerperConnection[]       @relation("CompanySerperConnectionCreatedBy")
  createdOmsConnections              CompanyOmsConnection[]          @relation("CompanyOmsConnectionCreatedBy")
  grantedIntegrationConnectionGrants IntegrationConnectionGrant[]    @relation("IntegrationConnectionGrantGrantedBy")
  departmentPreference               UserDepartmentPreference?
  personaLearningEvidenceAsManager   PersonaLearningEvidence[]       @relation("PersonaLearningEvidenceManager")
  personaLearningCandidatesAsManager PersonaLearningCandidate[]      @relation("PersonaLearningCandidateManager")
  managerPersonaTrees                ManagerPersonaTree[]            @relation("ManagerPersonaTreeManager")
  managerPersonaNodes                ManagerPersonaNode[]            @relation("ManagerPersonaNodeManager")
  managerTeachSessions               ManagerTeachSession[]           @relation("ManagerTeachSessionManager")
  connectionAuthorizationIntents     ConnectionAuthorizationIntent[]
  mailboxSubscriptions               MailboxSubscription[]
  mailAutomationRules                MailAutomationRule[]
  mailBriefs                         MailBrief[]
  knowledgeResourcesOwned            KnowledgeResource[]             @relation("KnowledgeResourceOwner")
  knowledgeResourcesCreated          KnowledgeResource[]             @relation("KnowledgeResourceCreatedBy")
  knowledgeVersionsCreated           KnowledgeVersion[]              @relation("KnowledgeVersionCreatedBy")
  knowledgeMutationsRequested        KnowledgeMutation[]             @relation("KnowledgeMutationRequester")
  knowledgeMutationTargets           KnowledgeMutation[]             @relation("KnowledgeMutationOwner")
  knowledgeLearningJobs              KnowledgeLearningJob[]
  knowledgeFileAssetsUploaded        KnowledgeFileAsset[]            @relation("KnowledgeFileAssetUploadedBy")
  integrationOAuthAttempts           IntegrationOAuthAttempt[]
}

