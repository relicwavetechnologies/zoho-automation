  updatedAt     DateTime              @updatedAt

  @@unique([connectionId, granteeType, granteeId])
  @@index([companyId, granteeType, granteeId, revokedAt])
  @@index([companyId, connectionId, revokedAt])
}

model DesktopAuthHandoff {
  id         String    @id @default(uuid())
