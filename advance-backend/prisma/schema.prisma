/// One outbound delivery attempt-set for a single piece of a run's answer.
///
/// Wave 2 made an incoming message survive a restart, but at-least-once
/// execution only guarantees the work happens again — not that the user sees
/// one answer. This row is what makes the resend safe: the key is derived from
/// the run and the segment being delivered, so a retry after a lost HTTP
/// response finds the existing record instead of sending a second reply.
model ChannelDelivery {
  id                String    @id @default(uuid())
  channel           String
  /// Stable across every retry of this segment — also sent to Lark as `uuid`.
  idempotencyKey    String
  /// Correlates every segment belonging to one agent run.
  runKey            String
  /// Which part of the answer this is: final, continuation, or status.
  purpose           String
  segmentIndex      Int       @default(0)
  status            String    @default("pending")
  attempts          Int       @default(0)
  companyId         String?
  chatId            String?
  /// The rendered reply, kept so a failed delivery can be resent without
  /// re-running the agent that produced it. Cleared once delivered.
  payloadJson       Json?
  /// Provider message ID once the send is confirmed.
  providerMessageId String?
  lastError         String?
  /// Set when a send failed in a way that leaves delivery genuinely unknown.
  ambiguous         Boolean   @default(false)
  firstAttemptAt    DateTime  @default(now())
  startedAt         DateTime?
  deliveredAt       DateTime?
  nextAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([channel, idempotencyKey])
  @@index([channel, status, nextAttemptAt])
  @@index([runKey])
  @@index([channel, status, firstAttemptAt])
}

/// One row per execution lane, holding at most one live owner.
///
/// The unique key is the mutual exclusion: two replicas cannot both hold the
/// same lane, because the second insert collides. Ownership is a lease rather
/// than a flag so that a replica killed mid-run releases the lane by ceasing to
/// heartbeat, instead of blocking it forever.
model ExecutionLaneLease {
  id           String    @id @default(uuid())
  channel      String
  /// Canonical lane identity — see `buildLarkIngressLaneKey`.
  laneKey      String
  /// Identifies the process that holds the lane, so only it can renew or release.
  ownerId      String
  /// Increments on every acquisition. A holder whose token is behind the
  /// lane's current one has been superseded and must not publish.
  fencingToken Int       @default(1)
  acquiredAt   DateTime  @default(now())
  heartbeatAt  DateTime  @default(now())
  /// Past this instant any worker may take the lane from its current owner.
  expiresAt    DateTime
  /// Set when an owner finishes cleanly; a released lane is free immediately
  /// rather than at expiry.
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([channel, laneKey])
  @@index([channel, expiresAt])
}

model IngressIdempotencyKey {
  id          String    @id @default(uuid())
  channel     String
  tenantKey   String
  eventId     String?
  messageId   String
  payloadJson Json
  /// Execution lane this event belongs to, recorded at acceptance so a burst
  /// can be found without re-parsing every pending payload. Nullable because
  /// receipts accepted before batching existed have no lane recorded.
  laneKey     String?
  status      String    @default("accepted")
  attempts    Int       @default(0)
  companyId   String?
  queueJobId  String?
  lastError   String?
  acceptedAt  DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([channel, tenantKey, messageId])
  @@index([channel, createdAt])
  @@index([channel, tenantKey, eventId])
  @@index([status, createdAt])
  @@index([channel, status, acceptedAt])
  @@index([channel, laneKey, status, acceptedAt])
}

