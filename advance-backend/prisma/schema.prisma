  errorCode               String?
  errorMessage            String?
  lastSequence            Int                      @default(0)
  startedAt               DateTime                 @default(now())
  finishedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  events                  ExecutionEvent[]
  stepResults             StepResult[]
  personaLearningEvidence PersonaLearningEvidence?

  @@index([companyId, startedAt])
  @@index([userId, startedAt])
  @@index([channel, startedAt])
  @@index([mode, startedAt])
  @@index([status, startedAt])
  @@index([taskId])
  @@index([threadId])
}

// Immutable, bounded evidence captured from a completed manager desktop run.
// `contextJson` contains redacted user/assistant excerpts only; raw tool I/O
// remains in the short-retention trace store and is never copied here.
model PersonaLearningEvidence {
  id                String                        @id @default(uuid())
  companyId         String
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId         String
  manager           User                          @relation("PersonaLearningEvidenceManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  executionRunId    String                        @unique
  executionRun      ExecutionRun                  @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  threadId          String
  sourceVersion     Int                           @default(1)
  status            PersonaLearningEvidenceStatus
  eligibilityReason String?
  contextJson       Json
  toolSummaryJson   Json
  runSummary        String?
  capturedAt        DateTime                      @default(now())
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  jobs              PersonaLearningJob[]
  candidates        PersonaLearningCandidate[]

  @@index([companyId, departmentId, managerId, capturedAt])
  @@index([status, capturedAt])
}

// Database-backed queue state. BullMQ is the executor, while this row is the
// durable/idempotent source of truth and supports reconciliation after outages.
model PersonaLearningJob {
  id              String                     @id @default(uuid())
  evidenceId      String
  evidence        PersonaLearningEvidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  pipelineVersion Int                        @default(1)
  idempotencyKey  String                     @unique
  status          PersonaLearningJobStatus   @default(queued)
  attempts        Int                        @default(0)
  queueJobId      String?
  modelProvider   String?
  modelId         String?
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  candidates      PersonaLearningCandidate[]

  @@unique([evidenceId, pipelineVersion])
  @@index([status, createdAt])
}

// Shadow-only output from the extraction model. P4 will introduce promotion,
// supersession, and generated persona views; these candidates are never used
// by runtime prompts in this migration.
model PersonaLearningCandidate {
  id               String                          @id @default(uuid())
  companyId        String
  company          Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId        String
  manager          User                            @relation("PersonaLearningCandidateManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department                      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  evidenceId       String
  evidence         PersonaLearningEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  jobId            String
  job              PersonaLearningJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ordinal          Int
  kind             PersonaLearningCandidateKind
  scopeKey         String
  ruleKey          String
  claim            String
  rationale        String
  evidenceStrength PersonaLearningEvidenceStrength
  status           PersonaLearningCandidateStatus  @default(shadow)
  promotedNodeId   String?
  promotedNode     ManagerPersonaNode?             @relation("ManagerPersonaNodeCandidates", fields: [promotedNodeId], references: [id], onDelete: SetNull)
  promotedAt       DateTime?
  createdAt        DateTime                        @default(now())

  @@unique([jobId, ordinal])
  @@index([companyId, departmentId, managerId, status, createdAt])
  @@index([evidenceId])
  @@index([status, ruleKey, createdAt])
}

// One manager-owned tree per department. Its revision is the freshness token
// consumed by the desktop runtime context in P5; it grants no authority.
model ManagerPersonaTree {
  id           String                   @id @default(uuid())
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId    String
  manager      User                     @relation("ManagerPersonaTreeManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  revision     Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  nodes        ManagerPersonaNode[]
  revisions    ManagerPersonaRevision[]

  @@unique([companyId, managerId, departmentId])
  @@index([companyId, departmentId, updatedAt])
}

// Bounded snapshots used only for Undo. The current tree remains live in
// ManagerPersonaNode; at most the two immediately previous snapshots remain.
model ManagerPersonaRevision {
  id           String             @id @default(uuid())
  treeId       String
  tree         ManagerPersonaTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  revision     Int
  snapshotJson Json
  source       String
  createdAt    DateTime           @default(now())

  @@unique([treeId, revision])
  @@index([treeId, createdAt])
}

// An active node is promoted only by the deterministic P4 evidence gate.
// It is instruction context, not an executable company skill or permission.
model ManagerPersonaNode {
  id              String                       @id @default(uuid())
  treeId          String
  tree            ManagerPersonaTree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId       String
  manager         User                         @relation("ManagerPersonaNodeManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind            PersonaLearningCandidateKind
  scopeKey        String
  ruleKey         String
  instruction     String
  confidence      Float
  evidenceCount   Int
  firstEvidenceAt DateTime
  lastEvidenceAt  DateTime
  status          ManagerPersonaNodeStatus     @default(active)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  candidates      PersonaLearningCandidate[]   @relation("ManagerPersonaNodeCandidates")

  @@unique([treeId, kind, scopeKey, ruleKey])
  @@index([companyId, departmentId, managerId, status, scopeKey])
}

// Durable job state for an explicit Teach recording. BullMQ executes the job,
// while this row is authoritative for progress, retries and cancellation.
model ManagerTeachSession {
  id                String                    @id @default(uuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId         String
  manager           User                      @relation("ManagerTeachSessionManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  source            ManagerTeachSource
  status            ManagerTeachSessionStatus @default(awaiting_upload)
  progress          Int                       @default(0)
  originalFileName  String?
  mimeType          String?
  fileSize          Int?
  queueJobId        String?
  attempts          Int                       @default(0)
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  lastError         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  artifacts         ManagerTeachArtifact[]

  @@index([companyId, departmentId, managerId, createdAt])
  @@index([status, createdAt])
}

model ManagerTeachArtifact {
  id         String                     @id @default(uuid())
  sessionId  String
  session    ManagerTeachSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind       ManagerTeachArtifactKind
  status     ManagerTeachArtifactStatus @default(available)
  storageKey String
  mimeType   String
  sizeBytes  Int
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@unique([sessionId, kind])
  @@index([status, expiresAt])
}

model ExecutionEvent {
  id          String       @id @default(uuid())
  executionId String
  execution   ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sequence    Int
  phase       String
  eventType   String
  actorType   String
  actorKey    String?
  title       String
  summary     String?
  status      String?
  payload     Json?
  createdAt   DateTime     @default(now())

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@index([createdAt])
}

model StepResult {
  id             String       @id @default(uuid())
  executionId    String
  execution      ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sequence       Int
  toolName       String
  actorKey       String?
  title          String?
  success        Boolean
  status         String?
  authorityLevel String?
  resolvedIds    Json?
  entityIndexes  Json?
  summary        String?
  rawOutput      Json?
  createdAt      DateTime     @default(now())

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@index([createdAt])
}

model RuntimeConversation {
  id                     String                       @id @default(uuid())
  companyId              String
  departmentId           String?
  channel                String
  channelConversationKey String
  rawChannelKey          String
  createdByUserId        String?
  createdByEmail         String?
  title                  String?
  status                 String                       @default("active")
  refsJson               Json?
  lastMessageSequence    Int                          @default(0)
  summaryJson            Json?
  summaryUpdatedAt       DateTime?
  lastSummarizedSequence Int                          @default(0)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  messages               RuntimeConversationMessage[]
  runs                   RuntimeRun[]
  approvals              RuntimeApproval[]
  parityReports          RuntimeShadowParityReport[]

  @@unique([companyId, channel, channelConversationKey])
  @@index([companyId, updatedAt])
  @@index([companyId, channel, updatedAt])
  @@index([departmentId, updatedAt])
}

model RuntimeConversationMessage {
  id              String              @id @default(uuid())
  conversationId  String
  conversation    RuntimeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId           String?
  run             RuntimeRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  sequence        Int
  role            String
  messageKind     String
  sourceChannel   String
  sourceMessageId String?
  dedupeKey       String?
  contentText     String?
  contentJson     Json?
  attachmentsJson Json?
  toolCallJson    Json?
  toolResultJson  Json?
  visibility      String              @default("internal")
  createdAt       DateTime            @default(now())

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
  @@index([dedupeKey])
}

model RuntimeRun {
  id             String                       @id @default(uuid())
  conversationId String
  conversation   RuntimeConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentRunId    String?
  engine         String                       @default("langgraph")
  engineMode     String                       @default("primary")
  channel        String
  entrypoint     String
  status         String                       @default("running")
  currentNode    String?
  stepCount      Int                          @default(0)
  maxSteps       Int                          @default(12)
  stopReason     String?
  errorJson      Json?
  traceJson      Json?
  metadataJson   Json?
  startedAt      DateTime                     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  messages       RuntimeConversationMessage[]
  approvals      RuntimeApproval[]
  snapshots      RuntimeSnapshot[]
  parityReports  RuntimeShadowParityReport[]

  @@index([conversationId, startedAt])
  @@index([parentRunId])
  @@index([channel, startedAt])
  @@index([status, startedAt])
}

model RuntimeApproval {
  id                  String              @id @default(uuid())
  conversationId      String
  conversation        RuntimeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId               String
  run                 RuntimeRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalActionId    String?
  toolId              String
  actionGroup         String
  kind                String
  summary             String
  subject             String?
  payloadJson         Json
  metadataJson        Json?
  riskLevel           String?
  status              String              @default("pending")
  channel             String
  requestedBy         String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  expiresAt           DateTime?
  executionResultJson Json?
  idempotencyKey      String?
  decisionMessageId   String?
  resolutionReason    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
  @@index([status, createdAt])
  @@index([externalActionId])
  @@index([idempotencyKey])
}

model RuntimeSnapshot {
  id        String     @id @default(uuid())
  runId     String
  run       RuntimeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex Int
  nodeName  String
  stateJson Json
  createdAt DateTime   @default(now())

  @@index([runId, createdAt])
  @@index([runId, stepIndex])
}

model RuntimeShadowParityReport {
  id               String               @id @default(uuid())
  conversationId   String?
  conversation     RuntimeConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  runId            String?
  run              RuntimeRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  channel          String
  baselineEngine   String
  candidateEngine  String
  baselineSummary  String?
  candidateSummary String?
  diffSummary      String?
  metricsJson      Json?
  createdAt        DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
  @@index([channel, createdAt])
}

model MemberTokenPolicy {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyId         String
  monthlyTokenLimit Int      @default(2000000) // 2M tokens/month default
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
}

/// Guardrails policy for the LLM proxy: per-member block / budget / rate / model allow-list.
model MemberProxyPolicy {
  id               String   @id @default(uuid())
  userId           String   @unique
  companyId        String
  blocked          Boolean  @default(false)
  monthlyBudgetUsd Float? // null = no cap
  rateLimitRpm     Int? // null = no per-minute cap
  allowedModels    String[] @default([]) // empty = all models allowed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
}

/// Encrypted upstream provider key (DeepSeek) the proxy resolves server-side.
/// The desktop never holds a key — it authenticates with its member token and
/// the backend attaches the resolved key. Resolution precedence: company → platform → env.
model ProxyProviderKey {
  id           String    @id @default(uuid())
  provider     String    @default("deepseek")
  scope        String // 'platform' | 'company'
  companyId    String? // null for platform scope
  scopeKey     String // 'platform' or the companyId — the uniqueness discriminator
  encryptedKey String // AES-256-GCM cipher text (token.crypto v1 format)
  keyLast4     String // last 4 chars for masked display; never the full key
  status       String    @default("active") // 'active' | 'disabled'
  createdBy    String? // admin userId who set it
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, scopeKey])
  @@index([companyId])
}

/// One row per proxied request — the audit trail behind the Guardrails live feed
/// + health metrics. Tokens are stored (cache-split); cost is priced at read via
/// pricing.ts (Track B), never stored. Writing this NEVER blocks the proxied call.
model ProxyRequestLog {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  executionRunId  String?
  model           String
  channel         String   @default("desktop")
  provider        String   @default("deepseek")
  agentTarget     String   @default("pi")
  decision        String // 'allowed' | 'denied'
  reason          String? // gate reason / error type when not allowed
  httpStatus      Int // status returned to the caller
  cacheHitTokens  Int      @default(0)
  cacheMissTokens Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0)
  keySource       String? // 'company' | 'platform' | 'env'
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([companyId, channel, createdAt])
}

model SupervisorTodo {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  channel   String
  chatId    String
  threadId  String?
  title     String
  status    String   @default("pending") // pending | in_progress | done | cancelled
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([companyId, userId, chatId, status])
  @@index([expiresAt])
}
