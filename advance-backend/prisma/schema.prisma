model DesktopThread {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
