}

/// Durable one-time state for provider OAuth callbacks.
model IntegrationOAuthAttempt {
  id                String    @id @default(uuid())
  stateHash         String    @unique
  provider          String
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalAccountId String
  requestedScopes   String[]
  returnTo          String?
  status            String    @default("pending")
  expiresAt         DateTime
  claimedAt         DateTime?
  completedAt       DateTime?
  failureCode       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, provider, status, expiresAt])
  @@index([status, expiresAt])
}

model IntegrationWebhookReceipt {
  id         String   @id @default(uuid())
  provider   String
  webhookId  String
  topic      String
  accountId  String
  receivedAt DateTime @default(now())

  @@unique([provider, webhookId])
  @@index([provider, accountId, receivedAt])
}

/// Bounded lifecycle for Shopify mandatory privacy requests. Protected export
/// content is AES-GCM encrypted; audit rows contain only this row's opaque id
/// and lifecycle state.
model ShopifyPrivacyRequest {
  id                     String                     @id @default(uuid())
  companyId              String
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shopDomain             String
  requestId              String
  customerIdHash         String?
  orderIdHashes          String[]                   @default([])
  state                  ShopifyPrivacyRequestState @default(received)
  exportPayloadEncrypted String?
  exportCipherVersion    Int?
  failureCode            String?
  deadlineAt             DateTime
  expiresAt              DateTime
  readyAt                DateTime?
  deliveredAt            DateTime?
  redactedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([companyId, shopDomain, requestId])
  @@index([companyId, shopDomain, state, createdAt])
  @@index([companyId, customerIdHash, state])
  @@index([state, expiresAt])
}

/// Backend-issued provenance for one successful Shopify read. The shop domain
/// is copied from the verified server-side connection so privacy erasure never
/// has to infer ownership from client-authored trace JSON or approval rows.
model ShopifyRunProvenance {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executionRunId String
  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  connectionId   String
  shopDomain     String
  toolId         String
  createdAt      DateTime     @default(now())

  @@unique([executionRunId, connectionId, toolId])
  @@index([companyId, shopDomain, createdAt])
  @@index([connectionId, createdAt])
}

model ShopifyRunErasureFence {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceId  String
  createdAt DateTime @default(now())

  @@unique([companyId, sourceId])
  @@index([createdAt])
}

/// One browser authorization attempt plus the exact agent continuation target.
///
/// Only a hash of the browser state is persisted. The callback claims the row
/// once, then a separate worker either starts a fresh agent run from the stored
/// request or resumes a typed backend action directly. No model stream stays
/// open while the user completes OAuth.
model ConnectionAuthorizationIntent {
  id                         String                 @id @default(uuid())
  stateHash                  String                 @unique
  activeDedupeKey            String?                @unique
  provider                   String
  companyId                  String
  company                    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId               String?
  department                 Department?            @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  connectionId               String?
  connection                 IntegrationConnection? @relation(fields: [connectionId, companyId, userId], references: [id, companyId, ownerUserId], onDelete: Restrict)
  larkOpenId                 String
  larkTenantKey              String
  chatId                     String
  chatType                   String
  originalMessageId          String
  rootMessageId              String?
  replyInThread              Boolean                @default(false)
  groupReplyMode             String?
  originalRequest            String
  requestedToolIds           String[]               @default([])
  status                     String                 @default("pending")
  continuationStatus         String                 @default("blocked")
  continuationIdempotencyKey String                 @unique
  continuationRunId          String?
  correlationId              String                 @unique
  failureCode                String?
  authorizationCodeEncrypted String?
  exchangeTokensEncrypted    String?
  exchangeStartedAt          DateTime?
  exchangeAttempts           Int                    @default(0)
  expiresAt                  DateTime
  consumedAt                 DateTime?
  connectedAt                DateTime?
  continuationQueuedAt       DateTime?
  continuationStartedAt      DateTime?
  continuationFinishedAt     DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([companyId, userId, provider, status])
  @@index([status, expiresAt])
  @@index([continuationStatus, continuationQueuedAt])
  @@index([connectionId])
}

/// One Pub/Sub-triggered history cursor and lease per connected Gmail mailbox.
/// Rules share this subscription so provider sync cost is per mailbox.
model MailboxSubscription {
  id                  String                  @id @default(uuid())
  companyId           String
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId        String                  @unique
  connection          IntegrationConnection   @relation(fields: [connectionId, companyId, userId], references: [id, companyId, ownerUserId], onDelete: Cascade)
  provider            String                  @default("google_workspace")
  mailboxEmail        String
  status              String                  @default("active")
  historyId           String?
  /// Where a truncated history pass stopped. Valid only against `historyId`,
  /// which is why the cursor is held still while this is set.
  historyPageToken    String?
  nextPollAt          DateTime                @default(now())
  watchExpirationAt   DateTime?
  nextWatchRenewalAt  DateTime                @default(now())
  watchRegisteredAt   DateTime?
  watchClaimToken     String?
  watchClaimedAt      DateTime?
  watchFailureCode    String?
  /// Consecutive failed watch registrations. Reconciliation covers a missing
  /// watch, so one failure is a delay rather than an outage; this is what
  /// separates "late" from "give up waiting and tell the owner".
  watchFailureCount   Int                     @default(0)
  signalVersion       Int                     @default(0)
  lastSignalAt        DateTime?
  lastSignalHistoryId String?
  lastSignalMessageId String?
  claimToken          String?
  claimedAt           DateTime?
  /// Last mailbox state the owner was told about. Notification fires on the
  /// transition into a broken state, not while it stays broken, so this must
  /// survive a restart — an in-memory guard would re-alert on every deploy.
  notifiedState       String?
  notifiedStateAt     DateTime?
  lastSyncAt          DateTime?
  lastSucceededAt     DateTime?
  lastFailedAt        DateTime?
  failureCode         String?
  lastError           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  rules               MailAutomationRule[]
  events              MailEvent[]
  reconciliations     MailboxReconciliation[]
  briefs              MailBrief[]

  @@unique([connectionId, companyId, userId])
  @@unique([id, companyId])
  @@unique([id, companyId, userId])
  @@index([status, nextPollAt])
  @@index([status, nextWatchRenewalAt])
  @@index([claimedAt])
  @@index([companyId, userId, status])
}

model MailAutomationRule {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User                @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?         @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  subscriptionId  String
  subscription    MailboxSubscription @relation(fields: [subscriptionId, companyId, createdByUserId], references: [id, companyId, userId], onDelete: Cascade)
  name            String
  status          String              @default("active")
  matchJson       Json
  actionJson      Json
  destinationJson Json
  /// The rule's optional AI step: one question asked of every matched message,
  /// and what to do when the model cannot answer it.
  ///
  /// Its own column rather than a key inside `actionJson` because it is not part
  /// of the action — it decides whether the action happens at all — and because
  /// `mailRuleDedupeKey` reads `actionJson`'s fields by name, so burying it
  /// there would invite somebody to fold it into the rule's identity. It must
  /// not be: see the note on `rateLimitPerHour` in `mail-ops.types.ts`.
  judgeJson       Json?
  dedupeKey       String?             @unique
  version         Int                 @default(1)
  pausedAt        DateTime?
  archivedAt      DateTime?
  /// When this rule most recently started watching for mail. Distinct from
  /// `createdAt`, which a revive or a replace leaves untouched: the rule row
  /// outlives its own archival, so `createdAt` can predate the current
  /// destination by months and is not a safe floor for "mail this rule is
  /// entitled to act on".
  activatedAt     DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deliveries      MailDelivery[]

  @@unique([id, companyId, subscriptionId])
  @@index([companyId, createdByUserId, status])
  @@index([subscriptionId, status])
}

/// A deduplicated new-message event discovered from Gmail history.
/// One stale-cursor recovery: what Divo had to fall back to, and what it cost.
///
/// A recovery means the mailbox cursor was rejected outright by Gmail, so mail
/// was missed and swept back in by date rather than by history. `truncated`
/// marks the case where the window held more than one pass reads, which is the
/// only place in the system where mail is knowingly lost — a log line was the
/// sole record of it, and log lines are not something anybody can query a month
/// later when asked what happened.
model MailboxReconciliation {
  id             String              @id @default(uuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   MailboxSubscription @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Cascade)
  recoveredCount Int                 @default(0)
  truncated      Boolean             @default(false)
  occurredAt     DateTime            @default(now())

  @@index([companyId, occurredAt])
  @@index([subscriptionId, occurredAt])
}

model MailEvent {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      MailboxSubscription @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Cascade)
  providerMessageId String
  providerThreadId  String?
  historyId         String
  metadataJson      Json
  occurredAt        DateTime
  createdAt         DateTime            @default(now())
  deliveries        MailDelivery[]

  @@unique([subscriptionId, providerMessageId])
  @@unique([id, companyId, subscriptionId])
  @@index([companyId, createdAt])
  @@index([subscriptionId, historyId])
  /// Retention sweeps by arrival age, hourly, forever. Without this every
  /// sweep is a sequential scan of the table it exists to keep small.
  @@index([occurredAt])
}

/// Durable, idempotent execution of one rule against one discovered event.
/// A standing summary of one mailbox, delivered to its owner's Lark DM.
///
/// Its own table rather than a `ScheduledWorkflow`, deliberately. That model is
/// shaped for agent runs — five of its columns are required and describe a
/// compiled prompt and a capability grant — and its service calls the Pi runtime
/// for every row that comes due, inside the member's own container, competing
/// with their interactive turns. A brief is a query and one summarising call; it
/// has no business holding a container open twice a day for every member in a
/// company.
///
/// What it does borrow is the two genuinely hard parts, and it borrows them as
/// code rather than as a table: `schedule-calculator.ts` for timezone and DST
/// arithmetic, and the mail worker's existing Lark DM delivery, which is the
/// same path a `lark_dm` mail rule already uses.
model MailBrief {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId     String
  subscription       MailboxSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Local times of day, e.g. `["09:00","16:00"]`.
  ///
  /// A list rather than a single time because twice a day is the default and the
  /// point of the feature. Two rows would have been the alternative, and would
  /// have shown the member two things to manage where they asked for one.
  timesJson          Json
  /// IANA name. Required, never guessed — a brief an hour out is worse than none.
  timeZone           String
  /// Weekdays it runs on, as `MO`…`SU`.
  daysJson           Json
  status             String              @default("active")
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  /// The instant the last delivered brief covered up to.
  ///
  /// The next one starts here rather than at "now minus twelve hours", so a run
  /// missed to an outage widens the following brief instead of silently dropping
  /// the mail in the gap. That gap is exactly when somebody most needs to be told.
  coveredThrough     DateTime?
  claimToken         String?
  claimedAt          DateTime?
  /// The last brief's own words, as the markdown it was composed from.
  ///
  /// The runner used to compose this, hand it to Lark and drop it, so the only
  /// copy of what Divo told somebody about their mail lived in a chat message.
  /// Any surface other than that chat had nothing to show and no way to check
  /// what was said.
  ///
  /// The text rather than the Lark card: the card is one renderer's envelope,
  /// and the markdown is the source it is built from.
  lastBriefText      String?
  /// How many messages the last brief named. Zero is a real, deliverable brief.
  lastBriefWantCount Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  /// One brief per mailbox per person. Asking for a second is editing the first.
  @@unique([userId, subscriptionId])
  @@index([status, nextRunAt])
  @@index([companyId, userId])
  @@index([claimedAt])
}

model MailDelivery {
  id                String             @id @default(uuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId            String
  subscriptionId    String
  rule              MailAutomationRule @relation(fields: [ruleId, companyId, subscriptionId], references: [id, companyId, subscriptionId], onDelete: Cascade)
  eventId           String
  event             MailEvent          @relation(fields: [eventId, companyId, subscriptionId], references: [id, companyId, subscriptionId], onDelete: Cascade)
  idempotencyKey    String             @unique
  status            String             @default("pending")
  attempts          Int                @default(0)
  payloadJson       Json?
  providerMessageId String?
  /// Gmail draft this forward is staged in, written before the send is
  /// attempted. On a retry its presence answers the only question that matters
  /// — did the previous attempt actually send? — using an identifier Divo owns,
  /// rather than a search index that lags the send by seconds.
  providerDraftId   String?
  /// What the rule's AI step decided about this message, and why.
  ///
  /// Deliberately its own column rather than a key inside `payloadJson`: that
  /// payload is swept off terminal rows by age, and on a message the step held
  /// back the verdict is the *only* record of why nothing was forwarded. Losing
  /// it would leave a member with a rule that silently drops mail and no way to
  /// find out what it objected to.
  judgeVerdictJson  Json?
  lastError         String?
  ambiguous         Boolean            @default(false)
  firstAttemptAt    DateTime           @default(now())
  startedAt         DateTime?
  deliveredAt       DateTime?
  nextAttemptAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([ruleId, eventId])
  @@index([companyId, status, nextAttemptAt])
  @@index([eventId])
  /// Same reason: the payload sweep selects terminal rows by age.
  @@index([status, updatedAt])
}

/// Connection-scoped operating controls. Access grants answer who may use a
/// connection; this record answers how safely they may use it. Manager policy
/// and company-admin overrides are intentionally stored separately so an
/// override never destroys the manager's original operating preference.
model IntegrationConnectionGovernance {
  id                  String                @id @default(uuid())
  companyId           String
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectionId        String                @unique
  connection          IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  managerPolicyJson   Json?
  managerConfiguredBy String?
  managerConfiguredAt DateTime?
  adminOverrideJson   Json?
  adminOverriddenBy   String?
  adminOverriddenAt   DateTime?
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([companyId, updatedAt])
}

/// Company-wide capability controls for facilities such as web search and
/// shared knowledge. This remains separate from connection governance because
/// these capabilities may have no OAuth connection or per-user owner.
model CompanyCapabilityGovernance {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  capabilityId String
  policyJson   Json
  configuredBy String?
  configuredAt DateTime @default(now())
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, capabilityId])
  @@index([companyId, updatedAt])
}

/// Company-owned Serper credentials. The raw key is AES-GCM encrypted and never
/// returned through the desktop API; the fingerprint only supports safe dedupe.
model CompanySerperConnection {
  id                     String    @id @default(uuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label                  String
  apiKeyEncrypted        String
  keyFingerprint         String
  status                 String    @default("connected")
  priority               Int       @default(0)
  lastTestedAt           DateTime?
  lastSucceededAt        DateTime?
  lastFailureAt          DateTime?
  lastFailureCode        String?
  lastUsedAt             DateTime?
  successfulRequestCount Int       @default(0)
  // A company admin copies this value from the Serper dashboard. Divo subtracts
  // only requests it observes after this timestamp; it is not a provider-synced balance.
  creditsAtLastSync      Int?
  usageAtLastCreditSync  Int       @default(0)
  creditsSyncedAt        DateTime?
  unavailableUntil       DateTime?
  createdBy              String?
  createdByUser          User?     @relation("CompanySerperConnectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  revokedAt              DateTime?

  @@unique([companyId, keyFingerprint])
  @@index([companyId, status, priority])
  @@index([companyId, status, unavailableUntil])
}

/// Company-owned OMS Site Data webhook keys. The key is AES-GCM encrypted and
/// never returned to the desktop, Pi, gateway, logs, or audit records.
model CompanyOmsConnection {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label            String
  apiKeyEncrypted  String
  keyFingerprint   String
  status           String    @default("connected")
  lastTestedAt     DateTime?
  lastSucceededAt  DateTime?
  lastFailureAt    DateTime?
  lastFailureCode  String?
  lastUsedAt       DateTime?
  unavailableUntil DateTime?
  revokedAt        DateTime?
  createdBy        String?
  createdByUser    User?     @relation("CompanyOmsConnectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, keyFingerprint])
  @@index([companyId, status, unavailableUntil])
}

model IntegrationConnectionGrant {
  id            String                @id @default(uuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
