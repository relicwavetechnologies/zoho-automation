  provider              String
  ownerType             String
  ownerUserId           String?
  ownerUser             User?                            @relation("IntegrationConnectionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  label                 String
  accountEmail          String?
  accountName           String?
  externalAccountId     String?
  dedupeKey             String
  status                String                           @default("connected")
  scopes                String[]
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenType             String?
  tokenCipherVersion    Int                              @default(1)
  tokenVersion          Int                              @default(0)
  refreshLeaseOwner     String?
  refreshLeaseExpiresAt DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenMetadata         Json?
  connectedAt           DateTime                         @default(now())
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdBy             String?
  createdByUser         User?                            @relation("IntegrationConnectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt             DateTime                         @default(now())
