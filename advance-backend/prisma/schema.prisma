model AiTokenUsage {
  id                    String   @id @default(uuid())
  userId                String
  companyId             String
  agentTarget           String // e.g. 'mastra.supervisor'
  modelId               String // e.g. 'gpt-4.1-mini'
  provider              String // 'openai' | 'google'
  channel               String // 'desktop' | 'lark' | 'web'
  threadId              String?
  // Links this LLM call to its run trace (Track A). Nullable: backend-channel
  // calls may not have a run id yet; desktop ingest always sets it.
  executionRunId        String?
  estimatedInputTokens  Int      @default(0)
  estimatedOutputTokens Int      @default(0)
  // Actual token counts from AI SDK response (if available)
  actualInputTokens     Int?
  actualOutputTokens    Int?
  // DeepSeek cache split (from PI usage.cacheRead / usage.cacheWrite). Cache-hit
  // input is priced far cheaper than cache-miss, so this is required for legit cost.
  cacheReadInputTokens  Int?
  cacheWriteInputTokens Int?
  // Provider-reported cost (PI usage.cost.total), kept only as a Track-B cross-check;
  // NOT the source of truth for billing.
  reportedCostUsd       Float?
  wasCompacted          Boolean  @default(false)
  mode                  String   @default("high") // 'fast' | 'high' | 'xtreme'
  createdAt             DateTime @default(now())

  @@index([userId, companyId, createdAt])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([companyId, modelId, createdAt])
  @@index([executionRunId])
}

model ExecutionRun {
  id                      String                   @id @default(uuid())
  companyId               String
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                  String?
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel                 String
  entrypoint              String
  requestId               String?                  @unique
  taskId                  String?
  threadId                String?
  chatId                  String?
  messageId               String?
  mode                    String?
  agentTarget             String?
  status                  String                   @default("running")
  latestSummary           String?
  errorCode               String?
  errorMessage            String?
  lastSequence            Int                      @default(0)
  protectedDataObserved   Boolean                  @default(false)
  startedAt               DateTime                 @default(now())
  finishedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  events                  ExecutionEvent[]
  spans                   ExecutionSpan[]
  stepResults             StepResult[]
  personaLearningEvidence PersonaLearningEvidence?
  shopifyProvenance       ShopifyRunProvenance[]

  @@index([companyId, startedAt])
  @@index([userId, startedAt])
  @@index([channel, startedAt])
  @@index([mode, startedAt])
  @@index([status, startedAt])
  @@index([taskId])
  @@index([threadId])
}

// Immutable, bounded evidence captured from a completed manager desktop run.
// `contextJson` contains redacted user/assistant excerpts only; raw tool I/O
// remains in the short-retention trace store and is never copied here.
model PersonaLearningEvidence {
  id                String                        @id @default(uuid())
  companyId         String
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId         String
  manager           User                          @relation("PersonaLearningEvidenceManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  executionRunId    String                        @unique
  executionRun      ExecutionRun                  @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  threadId          String
  sourceVersion     Int                           @default(1)
  status            PersonaLearningEvidenceStatus
  eligibilityReason String?
  contextJson       Json
  toolSummaryJson   Json
  runSummary        String?
  capturedAt        DateTime                      @default(now())
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  jobs              PersonaLearningJob[]
  candidates        PersonaLearningCandidate[]

  @@index([companyId, departmentId, managerId, capturedAt])
  @@index([status, capturedAt])
}

// Database-backed queue state. BullMQ is the executor, while this row is the
// durable/idempotent source of truth and supports reconciliation after outages.
model PersonaLearningJob {
  id              String                     @id @default(uuid())
  evidenceId      String
  evidence        PersonaLearningEvidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  pipelineVersion Int                        @default(1)
  idempotencyKey  String                     @unique
  status          PersonaLearningJobStatus   @default(queued)
  attempts        Int                        @default(0)
  queueJobId      String?
  modelProvider   String?
  modelId         String?
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  candidates      PersonaLearningCandidate[]

  @@unique([evidenceId, pipelineVersion])
  @@index([status, createdAt])
}

// Shadow-only output from the extraction model. P4 will introduce promotion,
// supersession, and generated persona views; these candidates are never used
// by runtime prompts in this migration.
model PersonaLearningCandidate {
  id               String                          @id @default(uuid())
  companyId        String
  company          Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId        String
  manager          User                            @relation("PersonaLearningCandidateManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department                      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  evidenceId       String
  evidence         PersonaLearningEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  jobId            String
  job              PersonaLearningJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ordinal          Int
  kind             PersonaLearningCandidateKind
  scopeKey         String
  ruleKey          String
  claim            String
  rationale        String
  evidenceStrength PersonaLearningEvidenceStrength
  status           PersonaLearningCandidateStatus  @default(shadow)
  promotedNodeId   String?
  promotedNode     ManagerPersonaNode?             @relation("ManagerPersonaNodeCandidates", fields: [promotedNodeId], references: [id], onDelete: SetNull)
  promotedAt       DateTime?
  createdAt        DateTime                        @default(now())

  @@unique([jobId, ordinal])
  @@index([companyId, departmentId, managerId, status, createdAt])
  @@index([evidenceId])
  @@index([status, ruleKey, createdAt])
}

// One manager-owned tree per department. Its revision is the freshness token
// consumed by the desktop runtime context in P5; it grants no authority.
model ManagerPersonaTree {
  id             String                        @id @default(uuid())
  companyId      String
  company        Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId      String
  manager        User                          @relation("ManagerPersonaTreeManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  revision       Int                           @default(1)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  nodes          ManagerPersonaNode[]
  revisions      ManagerPersonaRevision[]
  teachMutations ManagerTeachPersonaMutation[]

  @@unique([companyId, managerId, departmentId])
  @@index([companyId, departmentId, updatedAt])
}

// Bounded snapshots used only for Undo. The current tree remains live in
// ManagerPersonaNode; at most the two immediately previous snapshots remain.
model ManagerPersonaRevision {
  id           String             @id @default(uuid())
  treeId       String
  tree         ManagerPersonaTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  revision     Int
  snapshotJson Json
  source       String
  createdAt    DateTime           @default(now())

  @@unique([treeId, revision])
  @@index([treeId, createdAt])
}

// An active node is promoted by the passive evidence gate or written from an
// explicit Teach session. It is persona context, never executable authority.
model ManagerPersonaNode {
  id                 String                       @id @default(uuid())
  treeId             String
  tree               ManagerPersonaTree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId          String
  manager            User                         @relation("ManagerPersonaNodeManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind               PersonaLearningCandidateKind
  scopeKey           String
  ruleKey            String
  instruction        String
  confidence         Float
  evidenceCount      Int
  firstEvidenceAt    DateTime
  lastEvidenceAt     DateTime
  status             ManagerPersonaNodeStatus     @default(active)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  candidates         PersonaLearningCandidate[]   @relation("ManagerPersonaNodeCandidates")
  skillLinks         ManagerPersonaSkillLink[]
  learningProvenance ManagerLearningProvenance[]

  @@unique([treeId, kind, scopeKey, ruleKey])
  @@index([companyId, departmentId, managerId, status, scopeKey])
}

// Persona nodes own the manager's trigger/preference; linked skills own the
// reusable execution recipe. Runtime resolves this stable relation instead of
// relying on fuzzy skill search to rediscover a known procedure.
model ManagerPersonaSkillLink {
  personaNodeId String
  personaNode   ManagerPersonaNode @relation(fields: [personaNodeId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@id([personaNodeId, skillId])
  @@index([skillId])
}

// Durable job state for an explicit Teach recording. BullMQ executes the job,
// while this row is authoritative for progress, retries and cancellation.
model ManagerTeachSession {
  id                 String                       @id @default(uuid())
  companyId          String
  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managerId          String
  manager            User                         @relation("ManagerTeachSessionManager", fields: [managerId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  source             ManagerTeachSource
  status             ManagerTeachSessionStatus    @default(awaiting_upload)
  progress           Int                          @default(0)
  originalFileName   String?
  mimeType           String?
  fileSize           Int?
  queueJobId         String?
  attempts           Int                          @default(0)
  cancelRequestedAt  DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  lastError          String?
  parentSessionId    String?
  parentSession      ManagerTeachSession?         @relation("ManagerTeachRefinements", fields: [parentSessionId], references: [id], onDelete: SetNull)
  refinements        ManagerTeachSession[]        @relation("ManagerTeachRefinements")
  managerCorrection  String?
  agentMutationKey   String?                      @unique
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  artifacts          ManagerTeachArtifact[]
  personaMutation    ManagerTeachPersonaMutation?
  learningProvenance ManagerLearningProvenance[]

  @@index([companyId, departmentId, managerId, createdAt])
  @@index([parentSessionId, createdAt])
  @@index([status, createdAt])
}

// One compact, idempotent learning mutation per Teach session. The historical
// model/table name is retained for migration stability; patchJson now stores
// validated canonical persona and department-skill changes atomically.
model ManagerTeachPersonaMutation {
  id                 String                            @id @default(uuid())
  sessionId          String                            @unique
  session            ManagerTeachSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  treeId             String?
  tree               ManagerPersonaTree?               @relation(fields: [treeId], references: [id], onDelete: SetNull)
  baseRevision       Int?
  appliedRevision    Int?
  evidenceHash       String
  modelProvider      String
  modelId            String
  status             ManagerTeachPersonaMutationStatus
  understanding      String
  patchJson          Json
  appliedChangeCount Int                               @default(0)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  learningProvenance ManagerLearningProvenance[]

  @@index([treeId, createdAt])
  @@index([status, createdAt])
}

// Immutable provenance edges for explicit Teach learning. Passive chat/run
// provenance remains available through ManagerPersonaNode.candidates ->
// PersonaLearningEvidence. New writes set exactly one target; a target can
// later become null when the referenced canonical record is deleted.
model ManagerLearningProvenance {
  id             String                      @id @default(uuid())
  teachSessionId String
  teachSession   ManagerTeachSession         @relation(fields: [teachSessionId], references: [id], onDelete: Cascade)
  mutationId     String
  mutation       ManagerTeachPersonaMutation @relation(fields: [mutationId], references: [id], onDelete: Cascade)
  personaNodeId  String?
  personaNode    ManagerPersonaNode?         @relation(fields: [personaNodeId], references: [id], onDelete: SetNull)
  skillId        String?
  skill          Skill?                      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  decision       ManagerLearningDecision
  evidenceRefs   String[]                    @default([])
  rationale      String
  priorStateJson Json?
  createdAt      DateTime                    @default(now())

  @@index([teachSessionId, createdAt])
  @@index([mutationId])
  @@index([personaNodeId, createdAt])
  @@index([skillId, createdAt])
}

model ManagerTeachArtifact {
  id         String                     @id @default(uuid())
  sessionId  String
  session    ManagerTeachSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind       ManagerTeachArtifactKind
  status     ManagerTeachArtifactStatus @default(available)
  storageKey String
  mimeType   String
  sizeBytes  Int
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@unique([sessionId, kind])
  @@index([status, expiresAt])
}

model ExecutionEvent {
  id              String       @id @default(uuid())
  executionId     String
  execution       ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sequence        Int
  phase           String
  eventType       String
  actorType       String
  actorKey        String?
  title           String
  summary         String?
  status          String?
  payload         Json?
  // Source time is emitted by Pi before a fire-and-forget batch crosses the
  // network. `createdAt` remains the durable ingest time; conflating the two
  // makes a delayed batch look like delayed work.
  sourceTimestamp DateTime?
  createdAt       DateTime     @default(now())

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@index([createdAt])
}

// Causal latency ledger for one execution run. Event rows explain what
// happened; span rows explain where wall time went. The two are intentionally
// separate so backend child spans never compete with Pi event sequence IDs.
model ExecutionSpan {
  id           String       @id @default(uuid())
  executionId  String
  execution    ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  spanId       String
  parentSpanId String?
  name         String
  category     String
  source       String
  startedAt    DateTime
  endedAt      DateTime
  durationMs   Int
  status       String
  attributes   Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([executionId, spanId])
  @@index([executionId, startedAt])
  @@index([name, startedAt])
  @@index([createdAt])
}

model StepResult {
  id             String       @id @default(uuid())
  executionId    String
  execution      ExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)
  sequence       Int
  toolName       String
  actorKey       String?
  title          String?
  success        Boolean
  status         String?
  authorityLevel String?
  resolvedIds    Json?
  entityIndexes  Json?
  summary        String?
  rawOutput      Json?
  createdAt      DateTime     @default(now())

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@index([createdAt])
}

model RuntimeConversation {
  id                     String                       @id @default(uuid())
  companyId              String
  departmentId           String?
  channel                String
  channelConversationKey String
  rawChannelKey          String
  createdByUserId        String?
  createdByEmail         String?
  title                  String?
  status                 String                       @default("active")
  refsJson               Json?
  lastMessageSequence    Int                          @default(0)
  historyRevision        Int                          @default(0)
  summaryJson            Json?
  summaryUpdatedAt       DateTime?
  lastSummarizedSequence Int                          @default(0)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  messages               RuntimeConversationMessage[]
  runs                   RuntimeRun[]
  approvals              RuntimeApproval[]

  @@unique([companyId, channel, channelConversationKey])
  @@index([companyId, updatedAt])
  @@index([companyId, channel, updatedAt])
  @@index([departmentId, updatedAt])
}

model RuntimeConversationMessage {
  id              String              @id @default(uuid())
  conversationId  String
  conversation    RuntimeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId           String?
  run             RuntimeRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  sequence        Int
  role            String
  messageKind     String
  sourceChannel   String
  sourceMessageId String?
  sourceRunId     String?
  dedupeKey       String?
  contentText     String?
  contentJson     Json?
  attachmentsJson Json?
  toolCallJson    Json?
  toolResultJson  Json?
  visibility      String              @default("internal")
  createdAt       DateTime            @default(now())

  @@unique([conversationId, sequence])
  @@unique([conversationId, dedupeKey])
  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
  @@index([sourceRunId, createdAt])
  @@index([dedupeKey])
}

// Attachment-only direct messages are staged before the user asks what to do.
// This durable pointer is consumed by the next private run; bytes remain in the
// user's private Docker volume and expire there independently.
model RuntimePendingAttachment {
  id              String    @id @default(uuid())
  companyId       String
  userId          String
  channel         String
  conversationKey String
  requestId       String
  fileId          String
  descriptorJson  Json
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([companyId, userId, channel, conversationKey, requestId, fileId], map: "RuntimePendingAttachment_identity_file_key")
  @@index([companyId, userId, channel, conversationKey, consumedAt, expiresAt])
  @@index([expiresAt])
}

/// Files a member sent into a conversation, kept addressable by name so a tool
/// can put one onto a provider record without the model ever handling the
/// provider's file key.
///
/// Written for every inbound attachment, in both DMs and group chats, whether or
/// not a question came with it — the two cases that were previously unrecoverable
/// are a DM (where only a Pi fileId survived) and a file sent in the same message
/// as the instruction (where nothing was stored at all).
///
/// Looked up by chat and sender, deliberately not by the runtime thread key. A
/// group thread key carries the seeding message id, so a file posted as one
/// top-level message and the instruction posted as the next are two different
/// threads — which is the very shape this is for. conversationKey is kept for
/// diagnostics only.
model ConversationAttachment {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  channel         String
  conversationKey String
  chatId          String
  larkMessageId   String
  larkFileKey     String
  fileName        String
  mimeType        String
  sizeBytes       Int?
  receivedAt      DateTime @default(now())
  expiresAt       DateTime

  @@unique([companyId, channel, larkMessageId, larkFileKey], map: "ConversationAttachment_provider_file_key")
  @@index([companyId, userId, channel, chatId, expiresAt])
  @@index([expiresAt])
}

/// An invoice payload held before it is sent to Zoho.
///
/// Stored rather than passed back through the model on purpose: creation
/// replays this row, so what the member was shown and what Zoho receives cannot
/// drift apart. A model that rendered one invoice and created another would be
/// the exact failure the review is meant to prevent, and no instruction rules
/// it out.
model ZohoInvoiceStaging {
  id               String    @id @default(uuid())
  companyId        String
  userId           String
  connectionId     String
  organizationId   String?
  /// The exact body that will be POSTed to Zoho.
  payloadJson      Json
  /// What the member reads before saying yes.
  summary          String
  /// Deterministic findings plus the reviewer's verdict, issues and unsourced values.
  reviewJson       Json
  /// Filename to attach once the invoice exists.
  attachFileName   String?
  /// Which correction round this is; a re-stage after a fix supersedes its predecessor.
  attempt          Int       @default(1)
  supersedesId     String?
  /// Set once this payload has been created, so one staging cannot make two invoices.
  createdInvoiceId String?
  /// When the create was dispatched. A claim older than the write ceiling was
  /// left by a process that died holding it, not by a request still running.
  claimedAt        DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime

  @@index([companyId, userId, expiresAt])
  @@index([companyId, connectionId, createdInvoiceId])
  @@index([expiresAt])
}

/// A purchase-order payload held until the member confirms the rendered draft.
/// Creation replays this exact payload and claims it before dispatch so one
/// confirmation cannot create two purchase orders after a retry or lost stream.
model ZohoPurchaseOrderStaging {
  id                     String    @id @default(uuid())
  companyId              String
  userId                 String
  connectionId           String
  organizationId         String
  payloadJson            Json
  summary                String
  findingsJson           Json
  attachFileName         String?
  createdPurchaseOrderId String?
  claimedAt              DateTime?
  createdAt              DateTime  @default(now())
  expiresAt              DateTime

  @@index([companyId, userId, expiresAt])
  @@index([companyId, connectionId, createdPurchaseOrderId])
  @@index([expiresAt])
}

/// A vendor-bill payload held until the member confirms the rendered draft.
/// Creation replays this exact payload and claims it before dispatch so one
/// confirmation cannot create two bills after a retry or lost stream.
model ZohoBillStaging {
  id             String    @id @default(uuid())
  companyId      String
  userId         String
  connectionId   String
  organizationId String
  payloadJson    Json
  summary        String
  findingsJson   Json
  attachFileName String?
  createdBillId  String?
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@index([companyId, userId, expiresAt])
  @@index([companyId, connectionId, createdBillId])
  @@index([expiresAt])
}

model RuntimeRun {
  id             String                       @id @default(uuid())
  conversationId String
  conversation   RuntimeConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentRunId    String?
  engine         String                       @default("langgraph")
  engineMode     String                       @default("primary")
  channel        String
  entrypoint     String
  status         String                       @default("running")
  currentNode    String?
  stepCount      Int                          @default(0)
  maxSteps       Int                          @default(12)
  stopReason     String?
  errorJson      Json?
  traceJson      Json?
  metadataJson   Json?
  startedAt      DateTime                     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  messages       RuntimeConversationMessage[]
  approvals      RuntimeApproval[]

  @@index([conversationId, startedAt])
  @@index([parentRunId])
  @@index([channel, startedAt])
  @@index([status, startedAt])
}

model RuntimeApproval {
  id                  String              @id @default(uuid())
  conversationId      String
  conversation        RuntimeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId               String
  run                 RuntimeRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalActionId    String?
  toolId              String
  actionGroup         String
  kind                String
  summary             String
  subject             String?
  payloadJson         Json
  metadataJson        Json?
  riskLevel           String?
  status              String              @default("pending")
  channel             String
  requestedBy         String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  expiresAt           DateTime?
  executionResultJson Json?
  idempotencyKey      String?
  decisionMessageId   String?
  resolutionReason    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  knowledgeMutation   KnowledgeMutation?

  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
  @@index([status, createdAt])
  @@index([externalActionId])
  @@index([idempotencyKey])
}

// One durable resource exists in exactly one authenticated target. A request
// to publish to both a department and its company creates two resources and
// two mutations so neither target can inherit the other's approval.
model KnowledgeResource {
  id             String                  @id @default(uuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           KnowledgeResourceKind
  scope          KnowledgeResourceScope
  targetKey      String
  ownerUserId    String?
  ownerUser      User?                   @relation("KnowledgeResourceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  logicalKey     String
  status         KnowledgeResourceStatus @default(draft)
  currentVersion Int                     @default(0)
  createdById    String
  createdBy      User                    @relation("KnowledgeResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       KnowledgeVersion[]
  mutations      KnowledgeMutation[]
  projectedSkill Skill?
  fileAssets     KnowledgeFileAsset[]
  fileDocuments  KnowledgeFileDocument[]
  fileChunks     KnowledgeFileChunk[]

  @@unique([companyId, kind, targetKey, logicalKey])
  @@unique([id, companyId], map: "KnowledgeResource_id_companyId_key")
  @@index([companyId, scope, status, updatedAt])
  @@index([ownerUserId, kind, status, updatedAt])
  @@index([departmentId, kind, status, updatedAt])
}

// Private bytes are staged before any scope decision. The agent receives only
// this opaque asset ID; provider keys never become model-controlled authority.
// A staged asset can be attached to exactly one governed resource after the
// central mutation has passed RBAC and every required human decision.
model KnowledgeFileAsset {
  id                  String                   @id @default(uuid())
  companyId           String
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedById        String
  uploadedBy          User                     @relation("KnowledgeFileAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  knowledgeResourceId String?
  knowledgeResource   KnowledgeResource?       @relation(fields: [knowledgeResourceId], references: [id], onDelete: SetNull)
  mutations           KnowledgeMutation[]
  provider            String
  storageKey          String                   @unique
  resourceType        String
  deliveryType        String
  fileName            String
  mimeType            String
  sizeBytes           Int
  sha256              String
  inspectionVersion   String                   @default("strict-v1")
  inspectedAt         DateTime                 @default(now())
  threatScanProvider  String?
  threatScanVersion   String?
  threatScannedAt     DateTime?
  status              KnowledgeFileAssetStatus @default(staged)
  expiresAt           DateTime
  attachedAt          DateTime?
  deletedAt           DateTime?
  deletionLeaseToken  String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  document            KnowledgeFileDocument?

  @@index([companyId, uploadedById, status, createdAt])
  @@index([knowledgeResourceId, status])
  @@index([status, expiresAt])
  @@index([companyId, sha256])
}

// Parsed text is a reproducible, non-authoritative projection of one immutable
// governed file version. The original private object and KnowledgeVersion stay
// canonical; failed parsing never changes file visibility or approval state.
model KnowledgeFileDocument {
  id              String                      @id @default(uuid())
  companyId       String
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        KnowledgeResource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceVersion Int
  fileAssetId     String                      @unique
  fileAsset       KnowledgeFileAsset          @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  sourceSha256    String
  mimeType        String
  parserVersion   String
  status          KnowledgeFileDocumentStatus @default(processing)
  pageCount       Int?
  chunkCount      Int                         @default(0)
  warningsJson    Json?
  attempts        Int                         @default(0)
  lockedAt        DateTime?
  lockToken       String?
  indexedAt       DateTime?
  failureCode     String?
  failureMessage  String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  chunks          KnowledgeFileChunk[]

  @@unique([resourceId, resourceVersion])
  @@unique([id, companyId], map: "KnowledgeFileDocument_id_companyId_key")
  @@unique([id, companyId, resourceId, resourceVersion], map: "KnowledgeFileDocument_tenant_binding_key")
  @@index([companyId, status, updatedAt])
  @@index([resourceId, status, resourceVersion])
}

// Chunks retain page/section provenance for citations. `searchVector` is
// populated by the repository so Prisma db push and SQL migrations behave the
// same; Hindsight remains the semantic/reranking projection.
model KnowledgeFileChunk {
  id              String                   @id @default(uuid())
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentId      String
  document        KnowledgeFileDocument    @relation(fields: [documentId, companyId, resourceId, resourceVersion], references: [id, companyId, resourceId, resourceVersion], onDelete: Cascade)
  resourceId      String
  resource        KnowledgeResource        @relation(fields: [resourceId, companyId], references: [id, companyId], onDelete: Cascade)
  resourceVersion Int
  ordinal         Int
  pageStart       Int?
  pageEnd         Int?
  sectionPath     String[]                 @default([])
  text            String
  textHash        String
  charCount       Int
  tokenEstimate   Int
  searchVector    Unsupported("tsvector")?
  createdAt       DateTime                 @default(now())

  @@unique([documentId, ordinal])
  @@index([companyId, resourceId, resourceVersion, ordinal])
  @@index([documentId, pageStart, pageEnd])
  @@index([searchVector], type: Gin)
}

// Content versions are immutable. The hash is over canonical JSON and is also
// bound into requester review, human approval, and projection idempotency.
model KnowledgeVersion {
  id                 String                   @id @default(uuid())
  resourceId         String
  resource           KnowledgeResource        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version            Int
  contentJson        Json
  contentHash        String
  // Deterministic Postgres retrieval projection. This is rebuilt from the
  // immutable logical key + content and never becomes mutation authority.
  searchText         String?
  searchVector       Unsupported("tsvector")?
  evidenceJson       Json?
  sourceType         String
  sourceRef          String?
  createdById        String
  createdBy          User                     @relation("KnowledgeVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
  appliedByMutations KnowledgeMutation[]      @relation("KnowledgeMutationAppliedVersion")

  @@unique([resourceId, version])
  @@unique([resourceId, contentHash])
  @@index([contentHash])
  @@index([searchVector], type: Gin)
}

// This is the sole lifecycle authority for create/update/publish/delete. The
// model may propose content, but it cannot provide owner IDs, skip review, pick
// an approver, or write a projection directly.
model KnowledgeMutation {
  id                      String                     @id @default(uuid())
  companyId               String
  company                 Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resourceId              String?
  resource                KnowledgeResource?         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  kind                    KnowledgeResourceKind
  scope                   KnowledgeResourceScope
  targetKey               String
  ownerUserId             String?
  ownerUser               User?                      @relation("KnowledgeMutationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  departmentId            String?
  department              Department?                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  logicalKey              String
  action                  KnowledgeMutationAction
  baseVersion             Int?
  proposedContentJson     Json?
  proposedContentHash     String?
  evidenceJson            Json?
  sourceType              String
  sourceRef               String?
  requesterId             String
  requester               User                       @relation("KnowledgeMutationRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterReviewRequired Boolean
  requesterReviewedAt     DateTime?
  requiredAuthority       KnowledgeApprovalAuthority
  distinctApprover        Boolean                    @default(true)
  policyId                String
  policyVersion           Int
  runtimeApprovalId       String?                    @unique
  runtimeApproval         RuntimeApproval?           @relation(fields: [runtimeApprovalId], references: [id], onDelete: Restrict)
  appliedVersionId        String?
  appliedVersion          KnowledgeVersion?          @relation("KnowledgeMutationAppliedVersion", fields: [appliedVersionId], references: [id], onDelete: Restrict)
  fileAssetId             String?
  fileAsset               KnowledgeFileAsset?        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  status                  KnowledgeMutationStatus
  idempotencyKey          String                     @unique
  rejectionReason         String?
  failureCode             String?
  failureMessage          String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  decidedAt               DateTime?
  appliedAt               DateTime?
  outboxEvents            KnowledgeOutbox[]

  @@index([companyId, requesterId, status, createdAt])
  @@index([companyId, departmentId, status, createdAt])
  @@index([resourceId, createdAt])
  @@index([runtimeApprovalId])
  @@index([fileAssetId, status])
}

// Policies are data, not scattered tool conditionals. `tenantKey=global`
// provides the production defaults; a company ID can override one exact row.
model KnowledgePolicy {
  id                      String                     @id @default(uuid())
  tenantKey               String                     @default("global")
  kind                    KnowledgeResourceKind
  scope                   KnowledgeResourceScope
  action                  KnowledgeMutationAction
  requesterReviewRequired Boolean
  requiredAuthority       KnowledgeApprovalAuthority
  distinctApprover        Boolean                    @default(true)
  enabled                 Boolean                    @default(true)
  version                 Int                        @default(1)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([tenantKey, kind, scope, action])
  @@index([tenantKey, enabled])
}

// Projection side effects (Hindsight, skill registry, object visibility) are
// delivered from this transactional outbox. Containers can die after commit
// without losing or duplicating an authoritative mutation.
model KnowledgeOutbox {
  id          String                @id @default(uuid())
  mutationId  String
  mutation    KnowledgeMutation     @relation(fields: [mutationId], references: [id], onDelete: Cascade)
  eventType   String
  payloadJson Json
  dedupeKey   String                @unique
  status      KnowledgeOutboxStatus @default(pending)
  attempts    Int                   @default(0)
  availableAt DateTime              @default(now())
  lockedAt    DateTime?
  leaseToken  String?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, availableAt])
  @@index([mutationId])
}

// Completed user turns are first captured durably, then classified by a
// structured model in a retryable worker. The worker may propose personal
// memory only; the ordinary KnowledgeMutation policy remains the sole writer.
model KnowledgeLearningJob {
  id              String                     @id @default(uuid())
  companyId       String
  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId        String
  channel         String
  companyRole     String
  userMessages    Json
  assistantText   String?
  pipelineVersion Int                        @default(1)
  status          KnowledgeLearningJobStatus @default(queued)
  attempts        Int                        @default(0)
  lockedAt        DateTime?
  processedAt     DateTime?
  modelProvider   String?
  modelId         String?
  outcomesJson    Json?
  lastError       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([companyId, userId, sourceId, pipelineVersion], map: "KnowledgeLearningJob_identity_pipeline_key")
  @@index([status, lockedAt, createdAt])
  @@index([companyId, userId, createdAt])
}

model MemberTokenPolicy {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyId         String
  monthlyTokenLimit Int      @default(2000000) // 2M tokens/month default
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
}

/// Guardrails policy for the LLM proxy: per-member block / budget / rate / model allow-list.
model MemberProxyPolicy {
  id               String   @id @default(uuid())
  userId           String   @unique
  companyId        String
  blocked          Boolean  @default(false)
  monthlyBudgetUsd Float? // null = no cap
  rateLimitRpm     Int? // null = no per-minute cap
  allowedModels    String[] @default([]) // empty = all models allowed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
}

/// Encrypted upstream provider key (DeepSeek) the proxy resolves server-side.
/// The desktop never holds a key — it authenticates with its member token and
/// the backend attaches the resolved key. Resolution precedence: company → platform → env.
model ProxyProviderKey {
  id           String    @id @default(uuid())
  provider     String    @default("deepseek")
  scope        String // 'platform' | 'company'
  companyId    String? // null for platform scope
  scopeKey     String // 'platform' or the companyId — the uniqueness discriminator
  encryptedKey String // AES-256-GCM cipher text (token.crypto v1 format)
  keyLast4     String // last 4 chars for masked display; never the full key
  status       String    @default("active") // 'active' | 'disabled'
  createdBy    String? // admin userId who set it
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, scopeKey])
  @@index([companyId])
}

/// One row per proxied request — the audit trail behind the Guardrails live feed
/// + health metrics. Tokens are stored (cache-split); cost is priced at read via
/// pricing.ts (Track B), never stored. Writing this NEVER blocks the proxied call.
model ProxyRequestLog {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  executionRunId  String?
  model           String
  channel         String   @default("desktop")
  provider        String   @default("deepseek")
  agentTarget     String   @default("pi")
  decision        String // 'allowed' | 'denied'
  reason          String? // gate reason / error type when not allowed
  httpStatus      Int // status returned to the caller
  cacheHitTokens  Int      @default(0)
  cacheMissTokens Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0)
  keySource       String? // 'company' | 'platform' | 'env'
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([companyId, channel, createdAt])
}

/// A durable deliverable Divo wrote for one person, and the only copy of it that
/// outlives the container.
///
/// The agent writes an ordinary markdown file in its workspace and then badges
/// it with `divo_artifact`. The container is torn down when the run ends, so the
/// badge alone would name a file nobody can ever open again — this row is the
/// body, lifted out at badge time and addressable by a browser afterwards.
///
/// Keyed by `artifactId`, which the runtime derives from the file path. Revising
/// the same file re-badges the same key, so an edit updates this row in place and
/// bumps `version` rather than leaving the reader to guess which of five rows is
/// the current one.
///
/// Scoped to one member, not to a thread: a thread is where it was made, and it
/// may legitimately be made outside one. Ownership is the company/user pair, and
/// every read is checked against it.
model Artifact {
  id             String   @id @default(uuid())
  companyId      String
  userId         String
  /// Runtime-derived stable key. Same file path, same artifact, new version.
  artifactId     String
  /// The conversation it came out of, when there was one.
  threadId       String?
  executionRunId String?
  title          String
  mime           String   @default("text/markdown")
  body           String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, userId, artifactId])
  @@index([companyId, userId, updatedAt])
  @@index([companyId, userId, threadId, updatedAt])
}
