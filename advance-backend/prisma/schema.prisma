  desktopWorkspaces               DesktopWorkspace[]
  desktopThreads                  DesktopThread[]
  larkChatContexts                LarkChatContext[]
  scheduledWorkflows              ScheduledWorkflow[]
  executionRuns                   ExecutionRun[]
  knowledgeLearningJobs           KnowledgeLearningJob[]
  larkAuthLinks                   LarkUserAuthLink[]
  integrationConnections          IntegrationConnection[]
  integrationConnectionGrants     IntegrationConnectionGrant[]
  integrationConnectionGovernance IntegrationConnectionGovernance[]
  capabilityGovernance            CompanyCapabilityGovernance[]
  serperConnections               CompanySerperConnection[]
  omsConnections                  CompanyOmsConnection[]
  outboundArtifacts               OutboundArtifact[]
  userDepartmentPreferences       UserDepartmentPreference[]
  personaLearningEvidences        PersonaLearningEvidence[]
  personaLearningCandidates       PersonaLearningCandidate[]
  managerPersonaTrees             ManagerPersonaTree[]
  managerPersonaNodes             ManagerPersonaNode[]
  managerTeachSessions            ManagerTeachSession[]
  connectionAuthorizationIntents  ConnectionAuthorizationIntent[]
  mailboxSubscriptions            MailboxSubscription[]
  mailAutomationRules             MailAutomationRule[]
  mailEvents                      MailEvent[]
  mailDeliveries                  MailDelivery[]
  mailBriefs                      MailBrief[]
  mailboxReconciliations          MailboxReconciliation[]
  knowledgeResources              KnowledgeResource[]
  knowledgeMutations              KnowledgeMutation[]
  knowledgeFileAssets             KnowledgeFileAsset[]
  knowledgeFileDocuments          KnowledgeFileDocument[]
  knowledgeFileChunks             KnowledgeFileChunk[]
  integrationOAuthAttempts        IntegrationOAuthAttempt[]
