NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/divo
REDIS_URL=redis://localhost:6379

# Local VM Postgres tunnel used by scripts/db-tunnel.sh / pnpm dev:e2e.
# Prefer SSH key auth. If password auth is needed, set DB_TUNNEL_SSH_PASSWORD
# only in your local .env, never in tracked files.
DB_TUNNEL_SSH_HOST=<VPS_HOST>
DB_TUNNEL_SSH_USER=<VPS_SSH_USER>
DB_TUNNEL_LOCAL_PORT=15432
DB_TUNNEL_REMOTE_HOST=127.0.0.1
DB_TUNNEL_REMOTE_PORT=5432
DB_TUNNEL_DB_NAME=divo

OPENAI_API_KEY=sk-...
LARK_APP_ID=cli_...
LARK_APP_SECRET=...
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=
