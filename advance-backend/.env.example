NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://divo_dev_app:password@127.0.0.1:15432/divo_dev
REDIS_URL=redis://localhost:6379

# OAuth callbacks (Google / Lark / Zoho / Canva / Airtable) are built from the
# backend URL the Desktop signed in against, not from a pinned value here.
# List every non-loopback origin this deployment may serve; loopback is always
# allowed. Do NOT pin BACKEND_PUBLIC_URL to a deployment — it is only the
# last-resort fallback when a request arrives with no usable Host.
BACKEND_PUBLIC_URL_ALLOWLIST=https://app-dev.103.172.92.187.sslip.io
# Private/controller-reachable URL for validating short-lived Pi runtime
# leases against this exact backend instance. Keep this separate from the
# browser-facing OAuth origin when they resolve to different deployments.
PI_LARK_BACKEND_URL=http://127.0.0.1:3001
# Exact Message Card request URL configured in Lark Developer Console.
# Local interactive-card testing needs a stable HTTPS tunnel to this backend;
# do not point this at another deployment or card decisions will be lost.
LARK_CARD_CALLBACK_URL=https://app-dev.103.172.92.187.sslip.io/webhooks/lark/events

# Gmail push notifications. These identifiers are public configuration, not
# credentials; the push endpoint verifies Google-signed OIDC tokens.
GOOGLE_PUBSUB_TOPIC=projects/silver-adapter-498510-m6/topics/divo-gmail-events
GOOGLE_PUBSUB_SUBSCRIPTION=projects/silver-adapter-498510-m6/subscriptions/divo-gmail-push-dev
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://app-dev.103.172.92.187.sslip.io/api/google/gmail-pubsub/push
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=divo-pubsub-push@silver-adapter-498510-m6.iam.gserviceaccount.com

# Local VM Postgres tunnel used by scripts/db-tunnel.sh / pnpm dev:e2e.
# Prefer SSH key auth. If password auth is needed, set DB_TUNNEL_SSH_PASSWORD
# only in your local .env, never in tracked files.
DB_TUNNEL_SSH_HOST=103.172.92.187
DB_TUNNEL_SSH_USER=deploy
# DB_TUNNEL_SSH_IDENTITY_FILE=/absolute/path/to/private/key
DB_TUNNEL_LOCAL_PORT=15432
DB_TUNNEL_REMOTE_HOST=127.0.0.1
DB_TUNNEL_REMOTE_PORT=15433
DB_TUNNEL_DB_NAME=divo_dev

# Backend-managed Menhood reporting database. Leave disabled unless every
# value is configured; these credentials never belong in Desktop or Pi.
MENHOOD_ENABLED=false
MENHOOD_DB_HOST=
MENHOOD_DB_PORT=25432
MENHOOD_DB_NAME=
MENHOOD_DB_USER=
MENHOOD_DB_PASSWORD=
MENHOOD_COMPANY_ID=
MENHOOD_DB_SSL_MODE=require
# Base64-encoded PEM CA/server certificate and the DNS identity on that cert.
MENHOOD_DB_SSL_CA_BASE64=
MENHOOD_DB_SSL_SERVER_NAME=

OPENAI_API_KEY=sk-...
# Backend-owned semantic recall projection; versioned Postgres knowledge is
# the canonical source of truth. In Docker, HINDSIGHT_URL is set to the private
# service automatically. The same API key is configured on the
# self-hosted Hindsight tenant extension; it never reaches Desktop or Pi.
# External Hindsight deployments must also define the server-side `exact`
# retain strategy as `{"retain_extraction_mode":"verbatim",
# "enable_observations":false}`. The checked-in Compose services apply it to
# every newly-created bank so reviewed wording is not re-synthesized.
HINDSIGHT_ENABLED=false
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
KNOWLEDGE_PROJECTION_POLL_INTERVAL_MS=5000
KNOWLEDGE_PROJECTION_BATCH_SIZE=20
KNOWLEDGE_PROJECTION_MAX_ATTEMPTS=10
KNOWLEDGE_PROJECTION_PROCESSING_LEASE_SECONDS=300
KNOWLEDGE_HEALTH_PENDING_AGE_WARNING_SECONDS=300
KNOWLEDGE_LEARNING_ENABLED=true
REDIS_KNOWLEDGE_LEARNING_QUEUE_NAME=knowledge-learning
KNOWLEDGE_LEARNING_WORKER_CONCURRENCY=1
KNOWLEDGE_LEARNING_MODEL_ID=deepseek-v4-flash
KNOWLEDGE_LEARNING_IMMEDIATE_CONFIDENCE=0.9
KNOWLEDGE_LEARNING_REPEATED_CONFIDENCE=0.75
KNOWLEDGE_LEARNING_REPEATED_EVIDENCE_COUNT=3
KNOWLEDGE_FILE_MAX_MB=24
KNOWLEDGE_FILE_STAGING_TTL_HOURS=24
KNOWLEDGE_FILE_CLEANUP_INTERVAL_SECONDS=3600
KNOWLEDGE_FILE_DELETION_LEASE_SECONDS=300
KNOWLEDGE_FILE_MALWARE_SCAN_MODE=required
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_SECONDS=45
KNOWLEDGE_DOCUMENT_PARSE_TIMEOUT_SECONDS=300
KNOWLEDGE_DOCUMENT_INDEX_CONCURRENCY=2
KNOWLEDGE_DOCUMENT_MAX_PAGES=500
KNOWLEDGE_DOCUMENT_MAX_OCR_PAGES=100
KNOWLEDGE_DOCUMENT_MAX_ARCHIVE_ENTRIES=10000
KNOWLEDGE_DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=100000000
KNOWLEDGE_DOCUMENT_MAX_ARCHIVE_COMPRESSION_RATIO=200
KNOWLEDGE_DOCUMENT_CHUNK_TARGET_CHARS=2800
KNOWLEDGE_DOCUMENT_CHUNK_MAX_CHARS=3600
KNOWLEDGE_DOCUMENT_CHUNK_OVERLAP_CHARS=320
KNOWLEDGE_DOCUMENT_MAX_CHUNKS=2000
KNOWLEDGE_DOCUMENT_MAX_EXTRACTED_CHARS=4000000
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=1200
HINDSIGHT_REQUEST_TIMEOUT_MS=10000
HINDSIGHT_RECALL_CONCURRENCY=4
# Docker deployment secrets/config (set in the deployment environment).
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=gpt-4o-mini
HINDSIGHT_LLM_API_KEY=
# Semrush web routes only (www.semrush.com). No api.semrush.com key.
# SEMRUSH_WEB_API_KEY is the only credential the wired operations need.
# SEMRUSH_WEB_COOKIE is optional and is read by no wired operation; leave it
# empty unless Semrush enables /analytics/backlinks/webapi2 on the account.
# Copy into DIVO_DEV_ENV_FILE (dev VPS) and PRODUCTION_ENV_FILE (GitHub secret).
SEMRUSH_WEB_API_KEY=
SEMRUSH_WEB_COOKIE=
SEMRUSH_TIMEOUT_MS=15000
# Semrush keys exhaust in ordinary use. Where this is set it is the source of
# truth for the live key and SEMRUSH_WEB_API_KEY is only a fallback, so a spent
# key is replaced without a redeploy.
SEMRUSH_API_KEY_WEBHOOK_URL=
# Teach video evidence: Qwen OCR runs through OpenRouter; speech uses OpenAI;
# validated persona synthesis uses DeepSeek V4 Pro with max thinking.
OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-...
MANAGER_TEACH_OCR_MODEL=qwen/qwen2.5-vl-32b-instruct
MANAGER_TEACH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MANAGER_TEACH_PERSONA_MODEL=deepseek-v4-pro
# Optional tuning (defaults shown).
MANAGER_TEACH_MAX_FRAMES=40
MANAGER_TEACH_SCENE_THRESHOLD=0.12
MANAGER_TEACH_TRANSCRIPTION_CHUNK_SECONDS=300
MANAGER_TEACH_PERSONA_MIN_CONFIDENCE=0.9
LARK_APP_ID=cli_...
LARK_APP_SECRET=...
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=

# Agent Seat harness (local skill/tool testing). Your Lark DM or test group id
# where Divo should deliver export cards during manual harness runs. Local only —
# do not commit a teammate's personal chat id.
# AGENT_SEAT_DELIVERY_CHAT_ID=oc_your_lark_chat_id_here

# Four-eyes approval policy. Set true when manager-owned actions must be
# approved by a separate actor; this canonical setting works in production.
DIVO_APPROVAL_DISABLE_MANAGER_SELF_BYPASS=false
# Legacy non-production compatibility switch. Ignored when NODE_ENV=production.
DIVO_HITL_TEST_DISABLE_MANAGER_SELF_BYPASS=false

# Shopify Admin API. The Connected Apps screen normally stores per-store Dev
# Dashboard credentials. These env values are only for legacy browser OAuth and
# webhook HMAC validation; Pi and Desktop receive only opaque connection IDs.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=read_reports
# Keep false for analytics-only. When true, production startup also requires
# read_orders and read_customers and the two tools remain separately RBAC-granted.
SHOPIFY_PROTECTED_DATA_TOOLS_ENABLED=false
SHOPIFY_API_VERSION=2026-07
SHOPIFY_TIMEOUT_MS=20000
SHOPIFY_MAX_RETRIES=2
SHOPIFY_OAUTH_MAX_SKEW_SECONDS=300
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Optional, test-only live dev-store gate; never set these in committed files.
# RUN_SHOPIFY_E2E=1
# SHOPIFY_E2E_SHOP=your-dev-store.myshopify.com
# SHOPIFY_E2E_ACCESS_TOKEN=
