{
  "name": "advance-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed:dynamic-agents": "tsx scripts/seed-dynamic-agents.ts",
    "provision:share-memory": "tsx scripts/provision-share-memory.ts",
    "provision:lark-skills": "tsx scripts/provision-lark-skills.ts",
    "provision:google-workspace-skills": "tsx scripts/provision-google-workspace-skills.ts",
    "provision:zoho-finance-skills": "tsx scripts/provision-zoho-finance-skills.ts",
    "backfill:dept-permissions": "tsx scripts/backfill-dept-permissions.ts",
    "migrate:lark-connections": "tsx scripts/migrate-lark-user-auth-links.ts",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/tools/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "dev:e2e": "bash scripts/db-tunnel.sh start && bash scripts/dev.sh",
    "stop": "bash scripts/stop.sh"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.68",
    "@ai-sdk/openai": "^3.0.41",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.71.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.1.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.1.2",
    "ioredis": "5.9.2",
    "mammoth": "^1.12.0",
    "mem0ai": "^3.0.2",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.6.205",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "tsx": "^4.21.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "jose": "4.15.5",
      "@qdrant/js-client-rest": "1.17.0"
    }
  }
}
