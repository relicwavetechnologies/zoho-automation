{
  "name": "advance-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/tools/**/*.test.ts'",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "dev:e2e": "bash scripts/dev.sh"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@prisma/client": "^6.1.0",
    "ai": "^6.0.116",
    "bullmq": "^5.76.2",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.1.2",
    "ioredis": "5.9.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.6.205",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "jose": "4.15.5"
    }
  }
}
