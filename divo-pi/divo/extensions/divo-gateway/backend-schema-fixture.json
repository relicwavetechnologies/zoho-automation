     "create",
     "update",
     "complete",
     "delete",
     "list",
     "listMine",
     "listOpenMine",
     "get",
     "list_tasklists",
     "create_tasklist",
     "add_to_tasklist",
     "remove_from_tasklist",
     "list_subtasks",
     "create_subtask"
    ]
   },
   "title": {
    "type": "string"
   },
   "taskId": {
    "type": "string"
   },
   "dueDate": {
    "type": "string"
   },
   "assigneeIds": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "assigneeNames": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "followerIds": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "notes": {
    "type": "string"
   },
   "tasklist": {
    "type": "string"
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 100
   },
   "tasklistId": {
    "type": "string"
   },
   "parentTaskId": {
    "type": "string"
   },
   "connectionId": {
    "type": "string",
    "format": "uuid"
   }
  },
  "required": [
   "op"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
 },
