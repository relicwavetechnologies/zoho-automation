{
 "webSearch": {
  "type": "object",
  "properties": {
   "query": {
    "type": "string",
    "minLength": 1
   },
   "limit": {
    "type": "integer",
    "minimum": 1,
    "maximum": 10
   }
  },
  "required": [
   "query"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
 },
 "larkTask": {
