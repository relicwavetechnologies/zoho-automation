     "get_chart_of_accounts",
     "get_account_balance",
     "list_bank_transactions",
     "search_transactions",
     "get_tax_summary",
     "list_items",
     "list_taxes",
     "send_invoice",
     "record_payment",
     "create_expense",
     "create_bill",
     "create_contact",
