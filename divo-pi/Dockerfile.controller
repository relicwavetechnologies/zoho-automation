# syntax=docker/dockerfile:1.7

FROM docker:28.2.2-cli@sha256:280d9e6dbdeece0237d9ead6e5fbd59141ab1bce1ee7987760448809b8ea27aa AS docker-cli

FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates dumb-init \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
# Every module `divo/local-rpc-server.mjs` can reach, plus the trusted runtime
# manifest. `divo/test/controller-image-packaging.test.mjs` recomputes that
# import closure and fails if this list drifts from it.
COPY divo/approval-responder.mjs divo/run-result.mjs divo/runtime-rpc.mjs divo/auth.mjs divo/local-profile.mjs divo/local-rpc-controller.mjs divo/local-rpc-server.mjs divo/native-skills.mjs divo/ndjson-stream-writer.mjs divo/run-terminal.mjs divo/runtime-attachment-staging.mjs divo/runtime-attachments.mjs divo/runtime-channels.mjs divo/runtime-docker.mjs divo/runtime-identity.mjs divo/runtime-manifest.json divo/runtime-models.mjs divo/runtime-progress.mjs divo/runtime-turn-phases.mjs divo/runtime-warm-process.mjs ./divo/

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "divo/local-rpc-server.mjs"]
